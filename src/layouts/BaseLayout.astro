---
import '../styles/global.css';
import '../styles/scripture.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { BING_SITE_VERIFICATION } from 'astro:env/server';
import { absoluteUrl } from '../lib/bible/urls';

type Props = {
	title: string;
	description: string;
	canonicalPath?: string;
	noindex?: boolean;
	/** BCP-47 tag. Wrong the moment a non-English version is served. */
	lang?: string;
	/**
	 * Whether this page has a markdown twin at `<canonical>.md`.
	 *
	 * Set it only where a route actually serves one, and only where the twin is
	 * substantially the page: a reader page has no twin because its substance is
	 * licensed Scripture we do not republish as text. See lib/markdown.ts.
	 */
	markdown?: boolean;
	/** Root-relative or absolute. Defaults to the brand card. */
	image?: string;
	imageAlt?: string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
};

const {
	title,
	description,
	canonicalPath,
	noindex = false,
	markdown = false,
	lang = 'en',
	image = '/og-default.png',
	imageAlt = 'BibleHearth — read the Bible online, free',
	jsonLd,
} = Astro.props;

const canonical = canonicalPath ? absoluteUrl(Astro.site, canonicalPath) : undefined;
// Social scrapers and AI preview cards do not resolve relative image URLs.
const ogImage = /^https?:\/\//i.test(image) ? image : absoluteUrl(Astro.site, image);
const documents = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={lang}>
	<head>
		<!-- Google tag (gtag.js) -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-E46EVPHNWB"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-E46EVPHNWB');
		</script>
		<!-- Ahrefs Web Analytics -->
		<script
			is:inline
			src="https://analytics.ahrefs.com/analytics.js"
			data-key="Ow9f9XAzFN0a0KPkYNrfKw"
			async
		></script>
		<!-- Microsoft Clarity -->
		<script>
			import Clarity from '@microsoft/clarity';
			Clarity.init('y5ds69hyge');
		</script>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<link rel="icon" type="image/png" href="/favicon.png?v=2" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#f7f1e8" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{
			BING_SITE_VERIFICATION ? (
				<meta name="msvalidate.01" content={BING_SITE_VERIFICATION} />
			) : null
		}
		{noindex ? <meta name="robots" content="noindex, follow" /> : null}
		{canonical ? <link rel="canonical" href={canonical} /> : null}
		{/* llms.txt link relations. `alternate` is how an agent finds the markdown
		    twin without guessing at the convention; `describedby` points at the
		    index that says which pages have one. Both are advisory — nothing on
		    the site depends on either being followed. */}
		{
			markdown && canonical ? (
				<link rel="alternate" type="text/markdown" href={`${canonical}.md`} />
			) : null
		}
		<link rel="describedby" href={absoluteUrl(Astro.site, '/llms.txt')} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical ? <meta property="og:url" content={canonical} /> : null}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="BibleHearth" />
		<meta property="og:locale" content={lang.replace('-', '_')} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={imageAlt} />
		{
			documents.map((doc) => (
				<script is:inline type="application/ld+json" set:html={JSON.stringify(doc)} />
			))
		}
	</head>
	<body>
		<a class="skip-link" href="#content">Skip to content</a>
		<Header />
		<main id="content" class="wrap page">
			<slot />
		</main>
		<Footer />
		<Analytics />
	</body>
</html>
