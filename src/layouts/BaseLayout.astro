---
import '../styles/global.css';
import '../styles/scripture.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import {
	BING_SITE_VERIFICATION,
	GOOGLE_SITE_VERIFICATION,
} from 'astro:env/server';
import { absoluteMediaUrl, absoluteUrl } from '../lib/bible/urls';
import {
	DEFAULT_OG_IMAGE,
	OG_IMAGE_HEIGHT,
	OG_IMAGE_WIDTH,
} from '../lib/seo';

type Props = {
	title: string;
	description: string;
	canonicalPath?: string;
	noindex?: boolean;
	/** BCP-47 tag. Pass `locale.htmlLang`; it drives `lang`, `og:locale` and dates. */
	lang?: string;
	/**
	 * Text direction, for the five right-to-left locales.
	 *
	 * On `<html>` rather than in CSS because it is a property of the document's
	 * language, not of its styling: it decides how the browser orders neutral
	 * characters, which is why an Arabic chapter heading with a number in it —
	 * «مزمور 91» — renders with the number on the wrong side without it. Arabic,
	 * Hebrew, Persian and Sorani Kurdish all need it, and it is one attribute.
	 */
	dir?: 'ltr' | 'rtl';
	/**
	 * The same page in other languages, as `hreflang` alternates.
	 *
	 * Callers pass this only when the set is real — a page actually written in
	 * each locale named. Two rules make the cluster valid and both are the
	 * caller's to keep: every page in the cluster must list every other one
	 * *including itself*, which is why `x-default` and the self-reference are
	 * added here rather than asked for, and no page may point at a URL that is
	 * `noindex`. A cluster that breaks either is discarded whole, so a wrong
	 * `hreflang` is worse than none.
	 */
	alternates?: { hreflang: string; href: string }[];
	/**
	 * Whether this page has a markdown twin at `<canonical>.md`.
	 *
	 * Set it only where a route actually serves one, and only where the twin is
	 * substantially the page: a reader page has no twin because its substance is
	 * licensed Scripture we do not republish as text. See lib/markdown.ts.
	 */
	markdown?: boolean;
	/** Root-relative or absolute. Defaults to the brand card. */
	image?: string;
	imageAlt?: string;
	/**
	 * The page before and after this one, where the page sits in a real sequence.
	 *
	 * Emitted as `rel="prev"`/`rel="next"`. Google said in 2019 that it had
	 * stopped using these as an indexing signal and had not for years, so this is
	 * not here for Google. Bing still reads them, and this site is deliberately
	 * Bing-forward — IndexNow, the ownership token above, titles cut to Bing's
	 * 25-65 character window, and Bingbot given its own `robots.txt` group. On a
	 * Bible the sequence is also simply true, which is the other reason to state
	 * it: Genesis 1 really is followed by Genesis 2, and a crawler that knows the
	 * order can prioritise it rather than rediscovering it from anchors.
	 *
	 * Only for genuine linear sequence. A list of topics is not one.
	 */
	prev?: string;
	next?: string;
	/**
	 * The Open Graph type. `website` for a hub, `article` for a piece of writing.
	 *
	 * Worth distinguishing because the JSON-LD already does. A topic page, an
	 * answer page and a briefed chapter study each emit an `Article` node, and an
	 * `og:type` of `website` beside it is the same page describing itself two
	 * ways — a contradiction for anything that reads only the Open Graph tags,
	 * which includes most social and chat unfurlers. `article` is also what
	 * unlocks the published/modified times below.
	 *
	 * `website` stays the default, so a hub or a reader page says nothing new.
	 * Pass `article` only where the page carries our own writing; an un-briefed
	 * chapter page is `noindex` republished commentary and is not an article of
	 * ours to claim.
	 */
	ogType?: 'website' | 'article';
	/**
	 * Article timestamps, meaningful only when `ogType` is `article`.
	 *
	 * Same two dates the page's `Article` JSON-LD carries; pass both or neither
	 * so the two descriptions of the page cannot disagree.
	 */
	publishedTime?: Date;
	modifiedTime?: Date;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
};

const {
	title,
	description,
	canonicalPath,
	noindex = false,
	markdown = false,
	lang = 'en',
	dir = 'ltr',
	alternates = [],
	image = DEFAULT_OG_IMAGE,
	imageAlt = 'BibleHearth — read the Bible online, free',
	prev,
	next,
	ogType = 'website',
	publishedTime,
	modifiedTime,
	jsonLd,
} = Astro.props;

const canonical = canonicalPath ? absoluteUrl(Astro.site, canonicalPath) : undefined;
// Social scrapers and AI preview cards do not resolve relative image URLs.
const ogImage = absoluteMediaUrl(Astro.site, image);
const documents = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

/**
 * The `hreflang` cluster, absolute and with `x-default` appended.
 *
 * Absolute because the spec requires it — a relative `hreflang` href is ignored,
 * silently, which is the worst failure mode available here. `x-default` points
 * at English: it is what a search engine shows a reader whose language we do not
 * publish in, and English is the only locale that is not itself a translation.
 *
 * Emitted only when the caller passed a real cluster, so the common case — a
 * page that exists in one language — carries no alternates at all rather than a
 * self-reference dressed up as a choice.
 */
const hreflangs = alternates.length
	? [
			...alternates.map((entry) => ({
				hreflang: entry.hreflang,
				href: absoluteUrl(Astro.site, entry.href),
			})),
			...(alternates.find((entry) => entry.hreflang === 'en')
				? [
						{
							hreflang: 'x-default',
							href: absoluteUrl(
								Astro.site,
								alternates.find((entry) => entry.hreflang === 'en')!.href,
							),
						},
					]
				: []),
		]
	: [];
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<!-- Google tag (gtag.js) -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-E46EVPHNWB"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-E46EVPHNWB');
		</script>
		<!-- Ahrefs Web Analytics -->
		<script
			is:inline
			src="https://analytics.ahrefs.com/analytics.js"
			data-key="Ow9f9XAzFN0a0KPkYNrfKw"
			async
		></script>
		<!-- Microsoft Clarity -->
		<script>
			import Clarity from '@microsoft/clarity';
			Clarity.init('y5ds69hyge');
		</script>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<link rel="icon" type="image/png" href="/favicon.png?v=2" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#f7f1e8" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{
			BING_SITE_VERIFICATION ? (
				<meta name="msvalidate.01" content={BING_SITE_VERIFICATION} />
			) : null
		}
		{
			GOOGLE_SITE_VERIFICATION ? (
				<meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
			) : null
		}
		{noindex ? <meta name="robots" content="noindex, follow" /> : null}
		{canonical ? <link rel="canonical" href={canonical} /> : null}
		{hreflangs.map((entry) => (
			<link rel="alternate" hreflang={entry.hreflang} href={entry.href} />
		))}
		{prev ? <link rel="prev" href={absoluteUrl(Astro.site, prev)} /> : null}
		{next ? <link rel="next" href={absoluteUrl(Astro.site, next)} /> : null}
		{/* llms.txt link relations. `alternate` is how an agent finds the markdown
		    twin without guessing at the convention; `describedby` points at the
		    index that says which pages have one. Both are advisory — nothing on
		    the site depends on either being followed. */}
		{
			markdown && canonical ? (
				<link rel="alternate" type="text/markdown" href={`${canonical}.md`} />
			) : null
		}
		<link rel="describedby" href={absoluteUrl(Astro.site, '/llms.txt')} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical ? <meta property="og:url" content={canonical} /> : null}
		<meta property="og:type" content={ogType} />
		{
			ogType === 'article' && publishedTime ? (
				<meta
					property="article:published_time"
					content={publishedTime.toISOString()}
				/>
			) : null
		}
		{
			ogType === 'article' && modifiedTime ? (
				<meta
					property="article:modified_time"
					content={modifiedTime.toISOString()}
				/>
			) : null
		}
		<meta property="og:site_name" content="BibleHearth" />
		<meta property="og:locale" content={lang.replace('-', '_')} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
		<meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={imageAlt} />
		{
			documents.map((doc) => (
				<script is:inline type="application/ld+json" set:html={JSON.stringify(doc)} />
			))
		}
	</head>
	<body>
		<a class="skip-link" href="#content">Skip to content</a>
		<Header />
		<main id="content" class="wrap page">
			<slot />
		</main>
		<Footer />
		<Analytics />
	</body>
</html>
