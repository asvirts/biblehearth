---
import type { ExternalStudyLink } from '../lib/commentary/links';

type Props = {
	links: readonly ExternalStudyLink[];
	reference: string;
};

const { links, reference } = Astro.props;
---

{
	links.length ? (
		<section class="external-study">
			<h2>More resources for {reference}</h2>
			<p class="muted">
				These free resources come from The Gospel Coalition and BibleProject.
				Their work remains under their own copyright, so BibleHearth links to the
				original pages.
			</p>
			<ul class="external-links">
				{links.map((link) => (
					<li>
						<a href={link.href} rel="noopener" target="_blank">
							{link.label}
						</a>
						<span class="external-publisher">{link.publisher}</span>
						<p>{link.note}</p>
					</li>
				))}
			</ul>
		</section>
	) : null
}
