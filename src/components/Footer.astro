---
import { answerPath, listAnswers } from '../lib/answers';
import { listTopics, topicPath } from '../lib/topics';

// Footer links appear on every page, so this is how /topics and /answers stay
// discoverable from deep inside the reader tree.
const [topics, answers] = await Promise.all([listTopics(), listAnswers()]);
---

<footer class="site-footer">
	<div class="wrap">
		<nav class="footer-nav" aria-label="Footer">
			<div class="footer-col">
				<h2>Read</h2>
				<ul>
					<li><a href="/versions">Bible versions</a></li>
					<li><a href="/verse-of-the-day">Verse of the day</a></li>
					<li><a href="/commentary">Bible commentary</a></li>
				</ul>
			</div>
			<div class="footer-col">
				<h2>Topics</h2>
				<ul>
					{
						topics.slice(0, 5).map((topic) => (
							<li>
								<a href={topicPath(topic.id)}>{topic.data.title}</a>
							</li>
						))
					}
					<li><a href="/topics">All topics</a></li>
				</ul>
			</div>
			<div class="footer-col">
				<h2>Answers</h2>
				<ul>
					{
						answers.slice(0, 5).map((answer) => (
							<li>
								<a href={answerPath(answer.id)}>{answer.data.label}</a>
							</li>
						))
					}
					<li><a href="/answers">All questions</a></li>
				</ul>
			</div>
		</nav>
		<p>
			BibleHearth displays licensed Scripture from the YouVersion Platform. Each
			page includes the required publisher copyright for that Bible version.
			Topical verse selections are our own, informed by Nave's Topical Bible
			(1897) and Torrey's New Topical Textbook (1897), both public domain.
			Commentary pages reproduce Tyndale Open Study Notes under CC BY-SA 4.0,
			with Matthew Henry (1706) and Jamieson-Fausset-Brown (1871) in the public
			domain — see <a href="/attributions">attributions</a>.
		</p>
	</div>
</footer>
