---
import { answerPath, listAnswers } from '../lib/answers';
import { ABOUT_PATH, CONTACT_PATH, PRIVACY_PATH } from '../lib/site';
import { listTopics, topicPath } from '../lib/topics';

// Footer links appear on every page, so this is how /topics and /answers stay
// discoverable from deep inside the reader tree.
const [topics, answers] = await Promise.all([listTopics(), listAnswers()]);
---

<footer class="site-footer">
	<div class="wrap">
		<nav class="footer-nav" aria-label="Footer">
			<div class="footer-col">
				<h2>Read</h2>
				<ul>
					<li><a href="/versions">Bible versions</a></li>
					<li><a href="/verse-of-the-day">Verse of the day</a></li>
					<li><a href="/study">Chapter studies</a></li>
				</ul>
			</div>
			<div class="footer-col">
				<h2>Topics</h2>
				<ul>
					{
						topics.slice(0, 5).map((topic) => (
							<li>
								<a href={topicPath(topic.id)}>{topic.data.title}</a>
							</li>
						))
					}
					<li><a href="/topics">All topics</a></li>
				</ul>
			</div>
			<div class="footer-col">
				<h2>Answers</h2>
				<ul>
					{
						answers.slice(0, 5).map((answer) => (
							<li>
								<a href={answerPath(answer.id)}>{answer.data.label}</a>
							</li>
						))
					}
					<li><a href="/answers">All questions</a></li>
				</ul>
			</div>
			<div class="footer-col">
				<h2>This site</h2>
				<ul>
					<li><a href={ABOUT_PATH}>About BibleHearth</a></li>
					<li><a href={CONTACT_PATH}>Contact</a></li>
					<li><a href="/attributions">Attributions</a></li>
					<li><a href={PRIVACY_PATH}>Privacy</a></li>
				</ul>
			</div>
		</nav>
		<p>
			BibleHearth displays licensed Scripture from the YouVersion Platform, with
			the publisher's required copyright notice on every reader page. Topic lists
			are selected by BibleHearth with help from two public-domain indexes: Nave's
			Topical Bible (1897) and Torrey's New Topical Textbook (1897). Commentary
			pages include Tyndale Open Study Notes under CC BY-SA 4.0, plus the
			public-domain works of Matthew Henry (1706) and Jamieson-Fausset-Brown
			(1871). See <a href="/attributions">attributions</a> for details.
		</p>
	</div>
</footer>
