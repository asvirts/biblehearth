---
import BaseLayout from '../layouts/BaseLayout.astro';
import Figure from '../components/Figure.astro';
import { listAnswers } from '../lib/answers';
import { TOTAL_CHAPTERS } from '../lib/bible/chapters';
import { listChapterBriefs, STUDY_HUB_PATH } from '../lib/commentary';
import { READER_CACHE_CONTROL, setCacheControl } from '../lib/http';
import {
	breadcrumbJsonLd,
	organizationJsonLd,
	sitePageJsonLd,
} from '../lib/seo';
import {
	ABOUT_PATH,
	CONTACT_PATH,
	CORRECTIONS_ANCHOR,
	EDITORIAL_EMAIL,
} from '../lib/site';
import { listTopics } from '../lib/topics';
import { hubFigures } from '../lib/images/hubs';
import { shareCardFromFigure } from '../lib/images/og';

setCacheControl(Astro.response, READER_CACHE_CONTROL);

/*
 * Counted, not written down — from the same three lookups the sitemap and
 * llms.txt use.
 *
 * Every number below is a claim about how much of this site is our own work,
 * which is the claim this page exists to make. A hand-kept figure would be
 * wrong by the next brief, and a wrong number here is worse than no number:
 * it is the one thing on the page a sceptical reader can check in a minute.
 */
const [briefs, topics, answers] = await Promise.all([
	listChapterBriefs(),
	listTopics(),
	listAnswers(),
]);

const written = briefs.length;
const unwritten = TOTAL_CHAPTERS - written;
const count = (value: number) => value.toLocaleString('en-US');

const title = 'About BibleHearth · Who Writes This and Why';
const description =
	'Who publishes BibleHearth, how each chapter study is written, what this site refuses to publish, and where to write when we get something wrong.';

/*
 * The publisher's own description, which is not the page's.
 *
 * `description` above is written for a search result; this one is written for
 * the entity, and is what other pages inherit when they point at the
 * Organization node. Keeping them separate stops the About page's meta
 * description from quietly becoming the site's identity.
 */
const publisherDescription =
	'A free Bible site written for people in their first year of reading it: licensed English translations, alongside original plain-English writing on chapters, topics and the questions people actually ask.';

const figure = hubFigures.about;
const share = await shareCardFromFigure(figure);
---

<BaseLayout
	title={title}
	description={description}
	canonicalPath={ABOUT_PATH}
	image={share.image}
	imageAlt={share.imageAlt}
	jsonLd={[
		breadcrumbJsonLd(Astro.site, [
			{ name: 'BibleHearth', path: '/' },
			{ name: 'About', path: ABOUT_PATH },
		]),
		organizationJsonLd({
			site: Astro.site,
			description: publisherDescription,
		}),
		sitePageJsonLd({
			site: Astro.site,
			path: ABOUT_PATH,
			type: 'AboutPage',
			name: 'About BibleHearth',
			description,
		}),
	]}
>
	<nav class="crumbs" aria-label="Breadcrumb">
		<a href="/">Home</a>
		<span>/</span>
		<span>About</span>
	</nav>

	<h1>About BibleHearth</h1>

	<p class="lede">
		BibleHearth is a free Bible site written for people in their first year of
		reading it. This page says who publishes it, how the writing on it is made,
		what it refuses to publish, and where to write when we get something wrong.
	</p>

	<Figure figure={figure} />

	<section>
		<h2>What is on this site</h2>
		<p>
			Two kinds of page live here, and only one of them is ours.
		</p>
		<p>
			The reader is Scripture. It is licensed from each translation's publisher
			and served through the YouVersion Platform, and every page that shows a
			translation carries the copyright notice that publisher requires. We
			display that text under licence. We do not own it, and we do not
			reproduce it anywhere it is not licensed to appear — including the
			plain-text version of our own pages, where quoted verses become links
			instead.
		</p>
		<p>
			The rest is written here: {count(written)} chapter studies,
			{' '}{count(topics.length)} topic pages and {count(answers.length)} answers
			to questions people actually type into a search box. That writing is the
			part of the site to hold us to, and the rest of this page is about how it
			is made.
		</p>
	</section>

	<section>
		<h2>Who it is for</h2>
		<p>
			Someone who has picked up a Bible, or opened the app, and hit a chapter
			that does not explain itself.
		</p>
		<p>
			Every page is written on the assumption that you have not been to
			seminary and may never have been to church. No church word is used before
			it is explained — covenant, atonement, righteousness and the rest are
			defined where a reader first meets them, not in a glossary at the back.
			Where a passage is genuinely difficult, the page says so instead of
			smoothing it over.
		</p>
	</section>

	<section>
		<h2>How a chapter study is written</h2>
		<p>
			Each one is written against the chapter itself, in this order.
		</p>
		<ol class="outline-list">
			<li>
				<p>
					<strong>The chapter is read through in full</strong> before anything
					is written about it.
				</p>
			</li>
			<li>
				<p>
					<strong>It is laid out verse by verse, in the order it happens</strong>,
					with a heading for each movement — so the summary can be checked
					against the text rather than taken on trust.
				</p>
			</li>
			<li>
				<p>
					<strong>Every word that needs explaining is explained</strong> where it
					first appears, in plain English.
				</p>
			</li>
			<li>
				<p>
					<strong>What the chapter is routinely made to say, and does not, is
					stated plainly.</strong> This is the section most likely to disagree
					with something you have heard.
				</p>
			</li>
			<li>
				<p>
					<strong>The questions people are actually asking get answered</strong>,
					in the words they ask them in.
				</p>
			</li>
		</ol>
		<p>
			Three commentaries then appear underneath, reproduced in full and named:
			Tyndale's Open Study Notes, released under a Creative Commons licence, and
			Matthew Henry (1706) and Jamieson-Fausset-Brown (1871), both public
			domain. They are there so that you can check us. Where our reading and a
			three-hundred-year-old scholar's differ, you can see the difference on the
			same page instead of taking our word for it.
		</p>
		<p>
			Where they cover the chapter you are on, the page also links out to The
			Gospel Coalition's commentary and BibleProject's overview of the book —
			and never to a page we have not verified exists, which is why some
			chapters carry fewer links than others.
		</p>
		<p>
			Every study carries the month it was last reviewed. That date moves when
			the page does.
		</p>
	</section>

	<section>
		<h2>What this site will not publish</h2>
		<p>
			There are {count(TOTAL_CHAPTERS)} chapters in the Bible. {count(written)}
			{' '}of them are written up so far. The other {count(unwritten)} have a
			working page — you can read the chapter there, and the commentaries — but
			that page tells search engines not to index it, and it is kept out of the
			sitemap.
		</p>
		<p>
			That is deliberate, and it costs us almost the whole site. A page whose
			only substance is public-domain commentary that four larger sites already
			mirror has nothing to offer someone searching, however many of them we
			could generate. So a chapter earns its place in a search index by having
			something of our own written about it, and until then it stays out. The
			{' '}<a href={STUDY_HUB_PATH}>study index</a> lists the chapters that have
			cleared that bar.
		</p>
	</section>

	<section>
		<h2>What this site is not</h2>
		<p>
			It is not a church, and it is not a substitute for one. Nobody here is
			your pastor.
		</p>
		<p>
			These pages explain what a passage says, how it has been read, and where
			readers disagree. They do not tell you what to do about your marriage,
			your diagnosis or your grief. Where a topic touches something serious the
			page says so and points outward — the page on depression asks you to
			contact a doctor or a crisis line, in those words, because that is the
			right answer and a verse list is not.
		</p>
	</section>

	<section>
		<h2>Sources and licences</h2>
		<p>
			Every work reproduced or linked here is listed on the
			{' '}<a href="/attributions">attributions page</a>: who holds it, under
			what licence, and what we changed. Verse selections on the topic pages are
			our own, informed by Nave's Topical Bible (1897) and Torrey's New Topical
			Textbook (1897), both public domain.
		</p>
		<p>
			Nobody pays for placement in a verse list, and no page on this site is
			sponsored.
		</p>
	</section>

	<section id={CORRECTIONS_ANCHOR}>
		<h2>Corrections</h2>
		<p>
			If something here is wrong, tell us.
			{' '}<a href={`mailto:${EDITORIAL_EMAIL}`}>{EDITORIAL_EMAIL}</a> is a
			working inbox, read by the person responsible for these pages, and the
			{' '}<a href={CONTACT_PATH}>contact page</a> says what else it is for.
		</p>
		<p>
			A correction is made on the page itself and the review date moves with it.
			Where a page was wrong in a way that changed its meaning, it says on the
			page that it changed, rather than quietly reading better than it did the
			day before.
		</p>
	</section>

	<section>
		<h2>Who runs this</h2>
		<p>
			BibleHearth is independently run and has been publishing since August
			2026. It is not affiliated with a church, a denomination or a Bible
			publisher, and nothing written here is endorsed by one. Bible text reaches
			these pages through the YouVersion Platform, which any developer can apply
			for — a licence to display Scripture, not an endorsement of anything
			written around it.
		</p>
		<p>
			There is nothing to buy here, no account to make, no advertising and no
			newsletter. We measure which pages get read, using Google Analytics,
			Vercel Analytics, Ahrefs and Microsoft Clarity. Nothing on this site asks
			you for anything.
		</p>
	</section>
</BaseLayout>
