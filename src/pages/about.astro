---
import BaseLayout from '../layouts/BaseLayout.astro';
import Figure from '../components/Figure.astro';
import { listAnswers } from '../lib/answers';
import { TOTAL_CHAPTERS } from '../lib/bible/chapters';
import { listChapterBriefs, STUDY_HUB_PATH } from '../lib/commentary';
import { READER_CACHE_CONTROL, setCacheControl } from '../lib/http';
import {
	breadcrumbJsonLd,
	organizationJsonLd,
	sitePageJsonLd,
} from '../lib/seo';
import {
	ABOUT_PATH,
	CONTACT_PATH,
	CORRECTIONS_ANCHOR,
	EDITORIAL_EMAIL,
	SITE_OPERATOR,
} from '../lib/site';
import { listTopics } from '../lib/topics';
import { hubFigures } from '../lib/images/hubs';
import { shareCardFromFigure } from '../lib/images/og';

setCacheControl(Astro.response, READER_CACHE_CONTROL);

/*
 * Counted, not written down — from the same three lookups the sitemap and
 * llms.txt use.
 *
 * Every number below is a claim about how much of this site is our own work,
 * which is the claim this page exists to make. A hand-kept figure would be
 * wrong by the next brief, and a wrong number here is worse than no number:
 * it is the one thing on the page a sceptical reader can check in a minute.
 */
const [briefs, topics, answers] = await Promise.all([
	listChapterBriefs(),
	listTopics(),
	listAnswers(),
]);

const written = briefs.length;
const unwritten = TOTAL_CHAPTERS - written;
const count = (value: number) => value.toLocaleString('en-US');

const title = 'About BibleHearth · Who Writes This and Why';
const description =
	'Learn who publishes BibleHearth, how its studies are written and reviewed, and how to report a correction.';

/*
 * The publisher's own description, which is not the page's.
 *
 * `description` above is written for a search result; this one is written for
 * the entity, and is what other pages inherit when they point at the
 * Organization node. Keeping them separate stops the About page's meta
 * description from quietly becoming the site's identity.
 */
const publisherDescription =
	'A free Bible site for people who are still getting oriented to Scripture, with licensed translations and clear studies of chapters, topics, and common questions.';

const figure = hubFigures.about;
const share = figure ? await shareCardFromFigure(figure) : undefined;
---

<BaseLayout
	title={title}
	description={description}
	canonicalPath={ABOUT_PATH}
	image={share?.image}
	imageAlt={share?.imageAlt}
	jsonLd={[
		breadcrumbJsonLd(Astro.site, [
			{ name: 'BibleHearth', path: '/' },
			{ name: 'About', path: ABOUT_PATH },
		]),
		organizationJsonLd({
			site: Astro.site,
			description: publisherDescription,
		}),
		sitePageJsonLd({
			site: Astro.site,
			path: ABOUT_PATH,
			type: 'AboutPage',
			name: 'About BibleHearth',
			description,
		}),
	]}
>
	<nav class="crumbs" aria-label="Breadcrumb">
		<a href="/">Home</a>
		<span>/</span>
		<span>About</span>
	</nav>

	<h1>About BibleHearth</h1>

	<p class="lede">
		BibleHearth is a free Bible site for people who are still getting oriented to
		Scripture. Here is how the studies are written, which sources appear beside
		them, and how to tell us when something needs to be corrected.
	</p>

	{figure ? <Figure figure={figure} /> : null}

	<section>
		<h2>What is on this site</h2>
		<p>The site brings together Scripture and BibleHearth's own study material.</p>
		<p>
			The Bible reader displays Scripture licensed from each translation's
			publisher and served through the YouVersion Platform. Every page that shows
			a translation also carries the publisher's required copyright notice. The
			plain-text versions of our studies link to verses on the site because their
			license does not allow us to republish the passages there.
		</p>
		<p>
			The rest is written here: {count(written)} chapter studies,
			{' '}{count(topics.length)} topic pages and {count(answers.length)} answers
			to common Bible questions. BibleHearth is responsible for that writing and
			for keeping it clear, accurate, and current.
		</p>
	</section>

	<section>
		<h2>Who it is for</h2>
		<p>It is for anyone who opens the Bible and reaches a chapter that needs context.</p>
		<p>
			The studies assume no seminary training and no previous church experience.
			Terms such as covenant, atonement, and righteousness are explained when
			they first appear. Difficult passages stay difficult; the page gives you
			the background and the main ways readers have understood them.
		</p>
	</section>

	<section id="editorial-process">
		<h2>How a chapter study is written</h2>
		<p>Each study begins with the chapter and follows the same basic process.</p>
		<ol class="outline-list">
			<li>
				<p>
					<strong>The chapter is read through in full</strong> before anything
					is written about it.
				</p>
			</li>
			<li>
				<p>
					<strong>Its movement is mapped verse by verse.</strong> Each heading points
					back to the part of the chapter it explains, so readers can check the
					summary against the text.
				</p>
			</li>
			<li>
				<p>
					<strong>Every word that needs explaining is explained</strong> where it
					first appears, in plain English.
				</p>
			</li>
			<li>
				<p>
					<strong>Common misreadings are addressed directly.</strong> The caution
					section explains where a familiar interpretation asks more of the
					chapter than the words support.
				</p>
			</li>
			<li>
				<p>
					<strong>Common questions receive direct answers</strong> in the same words
					readers use when they ask them.
				</p>
			</li>
		</ol>
		<p>
			Three named commentaries appear underneath: Tyndale's Open Study Notes,
			released under a Creative Commons license, and Matthew Henry (1706) and
			Jamieson-Fausset-Brown (1871), both public domain. Reading them beside the
			study makes agreements and differences easy to see.
		</p>
		<p>
			Where they cover the chapter you are on, the page also links out to The
			Gospel Coalition's commentary and BibleProject's overview of the book. We
			check every destination before adding it, so some chapters have fewer links.
		</p>
		<p>
			Every study carries the month it was last reviewed. That date moves when
			the page does.
		</p>
	</section>

	<section>
		<h2>What this site will not publish</h2>
		<p>
			There are {count(TOTAL_CHAPTERS)} chapters in the Bible. {count(written)}
			{' '}of them are written up so far. The other {count(unwritten)} have a
			working page with commentaries and links to read the chapter. Until an
			original study is ready, that page stays out of search indexes and the
			sitemap.
		</p>
		<p>
			Larger sites already publish the same public-domain commentaries. An
			indexable BibleHearth page needs an original study that helps the reader
			understand the chapter. Until that study exists, the page stays out. The
			{' '}<a href={STUDY_HUB_PATH}>study index</a> lists the chapters that have
			cleared that bar.
		</p>
	</section>

	<section>
		<h2>Where this site's help ends</h2>
		<p>
			BibleHearth is a study resource. It is not a church or a substitute for
			pastoral care.
		</p>
		<p>
			These pages explain what a passage says, how it has been read, and where
			readers disagree. Personal decisions about a marriage, a diagnosis, or grief
			need help from people who know the situation. Pages that touch serious
			subjects say that clearly. The depression page, for example, directs readers
			to a doctor or crisis line when immediate help is needed.
		</p>
	</section>

	<section>
		<h2>Sources and licenses</h2>
		<p>
			Every work reproduced or linked here is listed on the
			{' '}<a href="/attributions">attributions page</a>: who holds it, under
			what license, and what we changed. Verse selections on the topic pages are
			our own, informed by Nave's Topical Bible (1897) and Torrey's New Topical
			Textbook (1897), both public domain.
		</p>
		<p>
			Nobody pays for placement in a verse list, and no page on this site is
			sponsored.
		</p>
	</section>

	<section id={CORRECTIONS_ANCHOR}>
		<h2>Corrections</h2>
		<p>
			If something here is wrong, tell us.
			{' '}<a href={`mailto:${EDITORIAL_EMAIL}`}>{EDITORIAL_EMAIL}</a> is a
			working inbox, read by the person responsible for these pages, and the
			{' '}<a href={CONTACT_PATH}>contact page</a> says what else it is for.
		</p>
		<p>
			A correction is made on the page itself and the review date moves with it.
			If an error changed the meaning of a page, the corrected page includes a
			note explaining what changed.
		</p>
	</section>

	<section id="who-runs-this">
		<h2>Who runs this</h2>
		<p>
			BibleHearth is independently run by {SITE_OPERATOR} and has been publishing since August
			2026. It is not affiliated with a church, a denomination or a Bible
			publisher, and nothing written here is endorsed by one. Bible text reaches
			these pages through the YouVersion Platform, which any developer can apply
			for. That license allows us to display Scripture; it is not an endorsement
			of the writing around it.
		</p>
		<p>
			There is nothing to buy here, no account to make, no advertising and no
			newsletter. We measure which pages get read, using Google Analytics,
			Vercel Analytics, Ahrefs and Microsoft Clarity. Nothing on this site asks
			you for anything.
		</p>
	</section>
</BaseLayout>
