---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Figure from '../../components/Figure.astro';
import { answerPath, listAnswers } from '../../lib/answers';
import { formatReference } from '../../lib/bible/refs';
import { truncateWords } from '../../lib/bible/text';
import { absoluteUrl } from '../../lib/bible/urls';
import { HOME_CACHE_CONTROL, setCacheControl } from '../../lib/http';
import { breadcrumbJsonLd, itemListJsonLd } from '../../lib/seo';
import { hubFigures } from '../../lib/images/hubs';
import { shareCardFromFigure } from '../../lib/images/og';

setCacheControl(Astro.response, HOME_CACHE_CONTROL);

const answers = await listAnswers();
// Labels are proper-noun phrases ("Sons of God in Genesis 6"), so they go in
// the description as written rather than lowercased the way topics are.
const labels = answers.map((answer) => answer.data.label);

const figure = hubFigures.answers;
const share = await shareCardFromFigure(figure);
---

<BaseLayout
	title="Bible Questions Answered — Hard Passages, Explained"
	description={truncateWords(
		`Straight answers to contested Bible questions, with the passage rendered in full and every serious reading compared honestly: ${labels.join(', ')}.`,
		155,
	)}
	canonicalPath="/answers"
	image={share.image}
	imageAlt={share.imageAlt}
	jsonLd={[
		breadcrumbJsonLd(Astro.site, [
			{ name: 'BibleHearth', path: '/' },
			{ name: 'Answers', path: '/answers' },
		]),
		itemListJsonLd({
			name: 'Bible questions answered',
			items: answers.map((answer) => ({
				name: answer.data.question,
				url: absoluteUrl(Astro.site, answerPath(answer.id)),
			})),
		}),
	]}
>
	<nav class="crumbs" aria-label="Breadcrumb">
		<a href="/">Home</a>
		<span>/</span>
		<span>Answers</span>
	</nav>

	<h1>Bible Questions, Answered</h1>
	<p class="lede">
		One question, one passage, and every reading that serious interpreters
		actually hold — with what supports each and the strongest objection to it.
		Where the evidence does not settle the question, these pages say so.
	</p>

	<Figure figure={figure} />

	<div class="stack">
		{
			answers.map((answer) => (
				<article class="panel">
					<h2>
						<a href={answerPath(answer.id)}>{answer.data.question}</a>
					</h2>
					{/* A direct answer makes this hub itself answerable. */}
					<p>{answer.data.shortAnswer}</p>
					<p class="muted">
						{formatReference(answer.data.anchor.passage)} ·{' '}
						{answer.data.views.length} readings compared
						{answer.data.faqs.length
							? ` · ${answer.data.faqs.length} related questions`
							: ''}
					</p>
				</article>
			))
		}
	</div>
</BaseLayout>
