---
import type { BiblePassage, BibleVersion } from '@youversion/platform-core';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import CopyrightNotice from '../../../../../components/CopyrightNotice.astro';
import Passage from '../../../../../components/Passage.astro';
import StatusMessage from '../../../../../components/StatusMessage.astro';
import {
	chapterBookTitle,
	isCanonicalBookSlug,
	isNumericChapter,
	isNumericVerse,
	usfmFromBookSlug,
} from '../../../../../lib/bible/usfm';
import {
	scriptureToPlainText,
	truncateWords,
} from '../../../../../lib/bible/text';
import {
	bookPath,
	chapterPath,
	versePath,
	versionPath,
} from '../../../../../lib/bible/urls';
import { READER_CACHE_CONTROL, setPageHeaders } from '../../../../../lib/http';
import { breadcrumbJsonLd, creativeWorkJsonLd } from '../../../../../lib/seo';
import {
	displayAbbreviation,
	errorStatus,
	findBook,
	getBibleIndex,
	getVerseHtml,
	type IndexedBook,
	resolveVersion,
	verseExists,
} from '../../../../../lib/youversion/api';

const requestedSlug = Astro.params.version;
const bookSlug = Astro.params.book;
const chapterId = Astro.params.chapter;
const verseId = Astro.params.verse;

if (
	!requestedSlug ||
	!bookSlug ||
	!chapterId ||
	!verseId ||
	!isNumericChapter(chapterId) ||
	!isNumericVerse(verseId)
) {
	return Astro.rewrite('/404');
}

const bookUsfm = usfmFromBookSlug(bookSlug);
if (!bookUsfm) {
	return Astro.rewrite('/404');
}

// Ahead of the version lookup for the same reason as the chapter route: an
// aliased book spelling is answerable from the URL alone.
if (!isCanonicalBookSlug(bookSlug, bookUsfm)) {
	return Astro.redirect(
		versePath(requestedSlug, bookUsfm, chapterId, verseId),
		301,
	);
}

let version: BibleVersion | null = null;
let slug = requestedSlug;
let book: IndexedBook | null = null;
let passage: BiblePassage | null = null;
let status = 200;

try {
	const resolved = await resolveVersion(requestedSlug);
	if (!resolved) {
		return Astro.rewrite('/404');
	}

	if (resolved.slug !== requestedSlug) {
		return Astro.redirect(
			versePath(resolved.slug, bookUsfm, chapterId, verseId),
			301,
		);
	}

	version = resolved.version;
	slug = resolved.slug;
	const index = await getBibleIndex(resolved.version.id);
	book = findBook(index, bookUsfm);
	if (!book || !verseExists(book, chapterId, verseId)) {
		return Astro.rewrite('/404');
	}

	// Sliced out of the chapter's cache entry rather than fetched on its own.
	// These pages are the largest crawlable surface on the site and the one no
	// sitemap submits, so a key per verse was a guaranteed cold fetch per crawl;
	// see getVerseHtml.
	passage = await getVerseHtml(resolved.version.id, bookUsfm, chapterId, verseId);
	if (!passage) {
		return Astro.rewrite('/404');
	}
} catch (error) {
	status = errorStatus(error);
	if (status === 404) {
		return Astro.rewrite('/404');
	}
}

Astro.response.status = status;
setPageHeaders(Astro.response, status, READER_CACHE_CONTROL);

const heading =
	passage?.reference ||
	(book && version
		? `${chapterBookTitle(book.id, book.title, version.language_tag)} ${chapterId}:${verseId} (${displayAbbreviation(version)})`
		: 'Verse');
const abbreviation = version ? displayAbbreviation(version) : '';
// Chapter pages carry the abbreviation but `passage.reference` does not,
// so verse titles used to silently drop the version.
const verseText = passage ? scriptureToPlainText(passage.content) : '';
const title = verseText
	? `${heading} ${abbreviation} — ${truncateWords(verseText, 50)}`
	: `${heading} ${abbreviation} · BibleHearth`.replace('  ', ' ');
const description = verseText
	? truncateWords(
			`${verseText} — ${heading}, ${abbreviation}. Read the full chapter and compare translations.`,
			155,
		)
	: `Read ${heading} on BibleHearth.`;
---

<BaseLayout
	title={title}
	description={description}
	lang={version?.language_tag ?? 'en'}
	canonicalPath={versePath(slug, bookUsfm, chapterId, verseId)}
	{/* One indexable page per verse reference, not one per (verse x version).
	    These stay live for readers and deep links, and keep passing link
	    equity, but the version-agnostic hub is the page that competes.
	    Deliberately NOT canonicalised to the hub: a single translation is not
	    equivalent to a side-by-side comparison, and asserting that would be
	    a false claim. */}
	noindex
	jsonLd={
		version && book
			? [
					breadcrumbJsonLd(Astro.site, [
						{ name: 'BibleHearth', path: '/' },
						{ name: displayAbbreviation(version), path: versionPath(slug) },
						{ name: book.title, path: bookPath(slug, book.id) },
						{
							name: `Chapter ${chapterId}`,
							path: chapterPath(slug, book.id, chapterId),
						},
						{
							name: `Verse ${verseId}`,
							path: versePath(slug, book.id, chapterId, verseId),
						},
					]),
					creativeWorkJsonLd({
						name: heading,
						description,
						inLanguage: version.language_tag,
						copyrightNotice: version.copyright,
					}),
				]
			: undefined
	}
>
	{
		status !== 200 || !version || !book || !passage ? (
			<StatusMessage
				title="This verse is unavailable"
				message="The requested verse could not be loaded for this Bible version."
			/>
		) : (
			<>
				<nav class="crumbs" aria-label="Breadcrumb">
					<a href="/">Home</a>
					<span>/</span>
					<a href={versionPath(slug)}>{displayAbbreviation(version)}</a>
					<span>/</span>
					<a href={bookPath(slug, book.id)}>{book.title}</a>
					<span>/</span>
					<a href={chapterPath(slug, book.id, chapterId)}>{chapterId}</a>
					<span>/</span>
					<span>{verseId}</span>
				</nav>
				<h1>{heading}</h1>
				<p>
					<a href={chapterPath(slug, book.id, chapterId)}>Read the full chapter</a>
					{' · '}
					<a href={`/verse/${bookSlug}/${chapterId}/${verseId}`}>
						Compare translations
					</a>
				</p>
				<Passage html={passage.content} />
				<CopyrightNotice version={version} />
			</>
		)
	}
</BaseLayout>
