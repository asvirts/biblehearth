---
import type { BiblePassage, BibleVersion } from '@youversion/platform-core';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import CopyrightNotice from '../../../../../components/CopyrightNotice.astro';
import Passage from '../../../../../components/Passage.astro';
import ReaderToolbar from '../../../../../components/ReaderToolbar.astro';
import RelatedQuestions from '../../../../../components/RelatedQuestions.astro';
import StatusMessage from '../../../../../components/StatusMessage.astro';
import { verseAnswerIndex } from '../../../../../lib/answers';
import {
	isCanonicalLocaleBookSlug,
	usfmFromLocaleBookSlug,
} from '../../../../../lib/bible/books';
import { chapterBriefIndex, chapterStudyPath } from '../../../../../lib/commentary';
import { displayChapterNumber, hebrewChapter } from '../../../../../lib/bible/psalms';
import { localeChapterReference } from '../../../../../lib/bible/refs';
import { chapterUsfm, isNumericChapter } from '../../../../../lib/bible/usfm';
import {
	scriptureToPlainText,
	truncateWords,
} from '../../../../../lib/bible/text';
import { topicPath, verseTopicIndex } from '../../../../../lib/topics';
import {
	bookPath,
	chapterPath,
	encodedPath,
	versionPath,
} from '../../../../../lib/bible/urls';
import { READER_CACHE_CONTROL, setPageHeaders } from '../../../../../lib/http';
import { localePath } from '../../../../../lib/i18n/locales';
import { breadcrumbJsonLd, creativeWorkJsonLd } from '../../../../../lib/seo';
import {
	adjacentReadableChapter,
	chapterExists,
	displayAbbreviation,
	errorStatus,
	findBook,
	getBibleIndex,
	getPassageHtml,
	type IndexedBible,
	type IndexedBook,
	listVersions,
	resolveVersion,
} from '../../../../../lib/youversion/api';

const requestedSlug = Astro.params.version;
const bookSlug = Astro.params.book;
const requestedChapter = Astro.params.chapter;
const locale = Astro.locals.locale;

if (
	!requestedSlug ||
	!bookSlug ||
	!requestedChapter ||
	!isNumericChapter(requestedChapter)
) {
	return Astro.rewrite('/404');
}

const bookUsfm = usfmFromLocaleBookSlug(locale, bookSlug);
const normalizedChapter = bookUsfm
	? hebrewChapter(locale, bookUsfm, requestedChapter)
	: null;
const chapterId = normalizedChapter === null ? null : String(normalizedChapter);
if (!bookUsfm || !chapterId) {
	return Astro.rewrite('/404');
}

/**
 * Ahead of `resolveVersion` deliberately, not folded into the version redirect
 * below: the book spelling is knowable from the URL alone, so an aliased path
 * costs no upstream call to turn away. A URL that is aliased in both segments
 * takes two hops, which is the price of not spending a licensed fetch to
 * discover that the first hop was avoidable.
 */
if (!isCanonicalLocaleBookSlug(locale, bookSlug, bookUsfm)) {
	return Astro.redirect(
		encodedPath(chapterPath(requestedSlug, bookUsfm, chapterId, locale)),
		301,
	);
}

let version: BibleVersion | null = null;
let slug = requestedSlug;
let index: IndexedBible | null = null;
let book: IndexedBook | null = null;
let catalog: BibleVersion[] = [];
let passage: BiblePassage | null = null;
let previousHref: string | null = null;
let nextHref: string | null = null;
let status = 200;

try {
	const resolved = await resolveVersion(requestedSlug, locale);
	if (!resolved) {
		return Astro.rewrite('/404');
	}

	if (resolved.slug !== requestedSlug) {
		return Astro.redirect(
			encodedPath(chapterPath(resolved.slug, bookUsfm, chapterId, locale)),
			301,
		);
	}

	version = resolved.version;
	slug = resolved.slug;
	[index, catalog, passage] = await Promise.all([
		getBibleIndex(resolved.version.id),
		listVersions(locale),
		getPassageHtml(resolved.version.id, chapterUsfm(bookUsfm, chapterId), {
			headings: true,
			notes: true,
		}),
	]);

	book = findBook(index, bookUsfm);
	if (!book || !chapterExists(book, chapterId) || !passage) {
		return Astro.rewrite('/404');
	}

	// These drive the Previous/Next links in the body and the `rel="prev"` and
	// `rel="next"` pair in the head. `adjacentReadableChapter` is what makes the
	// second one honest: it walks past book intros and non-numeric chapters and
	// crosses into the next book, so the sequence it states is the sequence a
	// reader actually gets rather than an assumption that chapter + 1 exists.
	const previous = adjacentReadableChapter(index, book.id, chapterId, 'previous');
	const next = adjacentReadableChapter(index, book.id, chapterId, 'next');
	previousHref = previous
		? chapterPath(slug, previous.bookId, previous.chapterId, locale)
		: null;
	nextHref = next
		? chapterPath(slug, next.bookId, next.chapterId, locale)
		: null;
} catch (error) {
	status = errorStatus(error);
	if (status === 404) {
		return Astro.rewrite('/404');
	}
}

Astro.response.status = status;
setPageHeaders(Astro.response, status, READER_CACHE_CONTROL);

// Reverse index: which topics and answers cite this chapter. Computed, never
// hand-kept, so a citation added to a topic or answer surfaces here on deploy.
const chapterKey = book ? `${book.id}.${chapterId}` : '';
const [{ byChapter: topicsByChapter }, { byChapter: answersByChapter }, briefs] =
	await Promise.all([
		verseTopicIndex(),
		verseAnswerIndex(),
		chapterBriefIndex(locale),
	]);
const chapterTopics = book ? (topicsByChapter.get(chapterKey) ?? []) : [];
const chapterAnswers = book ? (answersByChapter.get(chapterKey) ?? []) : [];
// The study page is version-agnostic, so its link has to earn the click on its
// own wording: a reader who has just finished the chapter needs to know whether
// a written summary is waiting or only the commentary notes.
const chapterBrief = book ? briefs.get(chapterKey) : undefined;

const reference = book
	? localeChapterReference(locale, book.id, chapterId)
	: 'Chapter';
const displayNumber = book
	? displayChapterNumber(locale, book.id, chapterId)
	: chapterId;
const abbreviation = version ? displayAbbreviation(version) : '';
const heading =
	book && version ? `${reference} (${abbreviation})` : 'Chapter';

const snippet = passage ? scriptureToPlainText(passage.content) : '';
/**
 * No Scripture in a chapter title, unlike the verse pages.
 *
 * Putting it there was meant to catch the way people search ("the lord is my
 * shepherd") rather than only the reference, and at verse level that works. A
 * chapter snippet begins at verse 1 and runs for a chapter, so it could only
 * ever appear cut — and a title that opens with 52 characters of Genesis 1:1
 * matches the same phrase on 1,189 other pages while pushing the one thing that
 * distinguishes this one, the reference and the translation, out of view. Bing
 * wants 25-65 characters; this stays inside that at both ends for every book
 * name in the canon.
 */
const title =
	book && version
		? `${reference} (${abbreviation}) — Read Online Free`
		: 'Read the Bible Online Free · BibleHearth';
const description = snippet
	? truncateWords(`${reference} in the ${abbreviation}: ${snippet}`, 155)
	: `Read ${heading} on BibleHearth.`;
---

<BaseLayout
	title={title}
	description={description}
	lang={locale.htmlLang}
	dir={locale.dir}
	canonicalPath={chapterPath(slug, bookUsfm, chapterId, locale)}
	prev={previousHref ?? undefined}
	next={nextHref ?? undefined}
	jsonLd={
		version && book
			? [
					breadcrumbJsonLd(Astro.site, [
						{ name: 'BibleHearth', path: localePath(locale, '/') },
						{
							name: displayAbbreviation(version),
							path: versionPath(slug, locale),
						},
						{
							name: book.title,
							path: bookPath(slug, book.id, locale),
						},
						{
							name: `Chapter ${displayNumber}`,
							path: chapterPath(slug, book.id, chapterId, locale),
						},
					]),
					creativeWorkJsonLd({
						name: heading,
						description,
						inLanguage: locale.htmlLang,
						copyrightNotice: version.copyright,
					}),
				]
			: undefined
	}
>
	{
		status !== 200 || !version || !book || !index || !passage ? (
			<StatusMessage
				title="This chapter is unavailable"
				message="The requested chapter could not be loaded for this Bible version."
			/>
		) : (
			<>
				<nav class="crumbs" aria-label="Breadcrumb">
					<a href={localePath(locale, '/')}>Home</a>
					<span>/</span>
					<a href={versionPath(slug, locale)}>{displayAbbreviation(version)}</a>
					<span>/</span>
					<a href={bookPath(slug, book.id, locale)}>{book.title}</a>
					<span>/</span>
					<span>{displayNumber}</span>
				</nav>
				<h1>{heading}</h1>
				<ReaderToolbar
					catalog={catalog}
					version={version}
					index={index}
					bookId={book.id}
					chapterId={chapterId}
					locale={locale}
				/>
				<Passage html={passage.content} />
				<nav class="pager">
					{previousHref ? (
						<a href={previousHref}>Previous chapter</a>
					) : (
						<span />
					)}
					{nextHref ? <a href={nextHref}>Next chapter</a> : <span />}
				</nav>
				{chapterBrief ? (
					<section class="study-cta panel">
						<h2>Understand {reference}</h2>
						<p>
							{chapterBrief.data.title}. The study includes an outline,
							definitions for unfamiliar words, and notes from three
							commentaries.
						</p>
						<a
							class="cta"
							href={chapterStudyPath(book.id, chapterId, locale)}
						>
							Read the {reference} study
						</a>
					</section>
				) : !locale.prefix ? (
					<p class="muted">
						<a href={chapterStudyPath(book.id, chapterId, locale)}>
							Commentary notes for {reference}
						</a>
					</p>
				) : null}
				<RelatedQuestions
					heading="Questions about this chapter"
					answers={chapterAnswers}
				/>
				{chapterTopics.length ? (
					<section class="chapter-topics">
						<h2>Topics in this chapter</h2>
						<ul class="topic-links">
							{chapterTopics.map((topic) => (
								<li>
									<a href={topicPath(topic.slug)}>
										Bible verses about {topic.title.toLowerCase()}
									</a>
								</li>
							))}
						</ul>
					</section>
				) : null}
				<CopyrightNotice version={version} />
			</>
		)
	}
</BaseLayout>
