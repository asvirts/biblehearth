---
import type { BibleVersion } from '@youversion/platform-core';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ChapterGrid from '../../../../components/ChapterGrid.astro';
import CopyrightNotice from '../../../../components/CopyrightNotice.astro';
import StatusMessage from '../../../../components/StatusMessage.astro';
import {
	isCanonicalLocaleBookSlug,
	usfmFromLocaleBookSlug,
} from '../../../../lib/bible/books';
import { bookPath, encodedPath, versionPath } from '../../../../lib/bible/urls';
import { READER_CACHE_CONTROL, setPageHeaders } from '../../../../lib/http';
import { localePath } from '../../../../lib/i18n/locales';
import { breadcrumbJsonLd } from '../../../../lib/seo';
import {
	displayAbbreviation,
	errorStatus,
	findBook,
	getBibleIndex,
	type IndexedBook,
	resolveVersion,
} from '../../../../lib/youversion/api';

const requestedSlug = Astro.params.version;
const bookSlug = Astro.params.book;
const locale = Astro.locals.locale;

if (!requestedSlug || !bookSlug) {
	return Astro.rewrite('/404');
}

const bookUsfm = usfmFromLocaleBookSlug(locale, bookSlug);
if (!bookUsfm) {
	return Astro.rewrite('/404');
}

// Ahead of the version lookup for the same reason as the chapter route: an
// aliased book spelling is answerable from the URL alone.
if (!isCanonicalLocaleBookSlug(locale, bookSlug, bookUsfm)) {
	return Astro.redirect(
		encodedPath(bookPath(requestedSlug, bookUsfm, locale)),
		301,
	);
}

let version: BibleVersion | null = null;
let slug = requestedSlug;
let book: IndexedBook | null = null;
let status = 200;

try {
	const resolved = await resolveVersion(requestedSlug, locale);
	if (!resolved) {
		return Astro.rewrite('/404');
	}

	if (resolved.slug !== requestedSlug) {
		return Astro.redirect(
			encodedPath(bookPath(resolved.slug, bookUsfm, locale)),
			301,
		);
	}

	version = resolved.version;
	slug = resolved.slug;
	const loadedIndex = await getBibleIndex(resolved.version.id);
	book = findBook(loadedIndex, bookUsfm);
	if (!book) {
		return Astro.rewrite('/404');
	}
} catch (error) {
	status = errorStatus(error);
	if (status === 404) {
		return Astro.rewrite('/404');
	}
}

Astro.response.status = status;
setPageHeaders(Astro.response, status, READER_CACHE_CONTROL);

const bookTitle = book?.title ?? bookSlug;
const versionLabel = version ? displayAbbreviation(version) : '';
---

<BaseLayout
	title={
		status === 200
			? `${bookTitle} (${versionLabel}) · BibleHearth`
			: 'Book unavailable · BibleHearth'
	}
	description={
		status === 200
			? `Read ${bookTitle} in the ${version?.localized_title || version?.title} by chapter.`
			: 'This Bible book could not be loaded.'
	}
	lang={locale.htmlLang}
	dir={locale.dir}
	canonicalPath={bookPath(slug, bookUsfm, locale)}
	jsonLd={
		version && book
			? breadcrumbJsonLd(Astro.site, [
					{ name: 'BibleHearth', path: localePath(locale, '/') },
					{
						name: displayAbbreviation(version),
						path: versionPath(slug, locale),
					},
					{ name: book.title, path: bookPath(slug, book.id, locale) },
				])
			: undefined
	}
>
	{
		status !== 200 || !version || !book ? (
			<StatusMessage
				title="This book is unavailable"
				message="The requested book could not be loaded for this Bible version."
			/>
		) : (
			<>
				<nav class="crumbs" aria-label="Breadcrumb">
					<a href={localePath(locale, '/')}>Home</a>
					<span>/</span>
					<a href={versionPath(slug, locale)}>{displayAbbreviation(version)}</a>
					<span>/</span>
					<span>{book.title}</span>
				</nav>
				<h1>
					{book.full_title || book.title}
					<span class="muted"> ({displayAbbreviation(version)})</span>
				</h1>
				<p class="lede">Select a chapter to read.</p>
				<ChapterGrid versionSlug={slug} book={book} locale={locale} />
				<CopyrightNotice version={version} />
			</>
		)
	}
</BaseLayout>
