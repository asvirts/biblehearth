---
import type { BibleVersion } from '@youversion/platform-core';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BookList from '../../../components/BookList.astro';
import CopyrightNotice from '../../../components/CopyrightNotice.astro';
import StatusMessage from '../../../components/StatusMessage.astro';
import { editionForSlug } from '../../../lib/bible/editions';
import { truncateWords } from '../../../lib/bible/text';
import { encodedPath, versionPath } from '../../../lib/bible/urls';
import { READER_CACHE_CONTROL, setPageHeaders } from '../../../lib/http';
import { localePath } from '../../../lib/i18n/locales';
import { breadcrumbJsonLd } from '../../../lib/seo';
import {
	displayAbbreviation,
	errorStatus,
	getBibleIndex,
	type IndexedBible,
	resolveVersion,
} from '../../../lib/youversion/api';

const requestedSlug = Astro.params.version;
const locale = Astro.locals.locale;

if (!requestedSlug) {
	return Astro.rewrite('/404');
}

let version: BibleVersion | null = null;
let slug = requestedSlug;
let index: IndexedBible | null = null;
let status = 200;

try {
	const resolved = await resolveVersion(requestedSlug, locale);
	if (!resolved) {
		return Astro.rewrite('/404');
	}

	if (resolved.slug !== requestedSlug) {
		return Astro.redirect(encodedPath(versionPath(resolved.slug, locale)), 301);
	}

	version = resolved.version;
	slug = resolved.slug;
	index = await getBibleIndex(resolved.version.id);
} catch (error) {
	status = errorStatus(error);
	if (status === 404) {
		return Astro.rewrite('/404');
	}
}

Astro.response.status = status;
setPageHeaders(Astro.response, status, READER_CACHE_CONTROL);

/**
 * Our own writing about this translation, where it exists. Absent for a version
 * nobody has written up yet, and the page falls back to the book list alone
 * rather than to an empty section.
 */
const edition = locale.prefix ? null : editionForSlug(slug);

const abbreviation = edition?.abbr ?? (version ? displayAbbreviation(version) : '');
const title = version
	? `${edition?.name ?? (version.localized_title || version.title)} (${abbreviation})`
	: 'Bible version';

/**
 * The title leads with the translation's name because that is the query, and
 * then says what the page answers — this is not another reader page, it is the
 * page that tells you whether this is the Bible you should be reading.
 */
const pageTitle = edition
	? `${title} | How It Reads and Who It’s For`
	: `${title} · BibleHearth`;
const breadcrumbs = [
	{ name: 'BibleHearth', path: localePath(locale, '/') },
	...(!locale.prefix ? [{ name: 'Versions', path: '/versions' }] : []),
	{
		name: version ? displayAbbreviation(version) : abbreviation,
		path: versionPath(slug, locale),
	},
];
---

<BaseLayout
	title={status === 200 ? pageTitle : 'Bible version unavailable · BibleHearth'}
	description={
		status !== 200
			? 'This Bible version could not be loaded.'
			: edition
				? truncateWords(edition.summary)
				: `Read the ${title} by book and chapter, with publisher copyright displayed on every page.`
	}
	lang={locale.htmlLang}
	dir={locale.dir}
	canonicalPath={versionPath(slug, locale)}
	jsonLd={
		version ? breadcrumbJsonLd(Astro.site, breadcrumbs) : undefined
	}
>
	{
		status !== 200 || !version || !index ? (
			<StatusMessage
				title="This version is unavailable"
				message="The Bible catalog or this translation could not be loaded right now."
			/>
		) : (
			<>
				<nav class="crumbs" aria-label="Breadcrumb">
					<a href={localePath(locale, '/')}>Home</a>
					{!locale.prefix ? (
						<>
							<span>/</span>
							<a href="/versions">Versions</a>
						</>
					) : null}
					<span>/</span>
					<span>{displayAbbreviation(version)}</span>
				</nav>
				<h1>{title}</h1>

				{
					edition ? (
						<>
							<p class="source-byline">{edition.byline}</p>
							<p class="lede">{edition.summary}</p>

							{edition.about.map((paragraph) => (
								<p class="source-about">{paragraph}</p>
							))}

							<dl class="glossary-list">
								<div class="glossary-item">
									<dt>How it translates</dt>
									<dd>{edition.approach}</dd>
								</div>
								<div class="glossary-item">
									<dt>Reading level</dt>
									<dd>{edition.readingLevel}</dd>
								</div>
								<div class="glossary-item">
									<dt>Best for</dt>
									<dd>{edition.bestFor}</dd>
								</div>
							</dl>

							<p class="source-reading-note">
								<strong>Worth knowing:</strong> {edition.caution}
							</p>

							{edition.compare.length > 0 ? (
								<section>
									<h2>Compare similar translations</h2>
									<dl class="glossary-list">
										{edition.compare.map((item) => (
											<div class="glossary-item">
												<dt>
													<a href={versionPath(item.slug, locale)}>{item.label}</a>
												</dt>
												<dd>{item.note}</dd>
											</div>
										))}
									</dl>
								</section>
							) : null}

							<h2>Read the {abbreviation} by book</h2>
						</>
					) : (
						<p class="lede">Choose a book to start reading.</p>
					)
				}

				<BookList versionSlug={slug} books={index.books} locale={locale} />
				<CopyrightNotice version={version} />
			</>
		)
	}
</BaseLayout>
