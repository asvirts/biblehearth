---
import BaseLayout from '../layouts/BaseLayout.astro';
import Figure from '../components/Figure.astro';
import {
	NEW_TESTAMENT_BOOKS,
	OLD_TESTAMENT_BOOKS,
	TOTAL_CHAPTERS,
	chapterCount,
} from '../lib/bible/chapters';
import { bookNameFromUsfm } from '../lib/bible/usfm';
import {
	COMMENTARY_SOURCES,
	STUDY_HUB_PATH,
	bookStudyPath,
	chapterStudyPath,
	listChapterBriefs,
} from '../lib/commentary';
import { READER_CACHE_CONTROL, setCacheControl } from '../lib/http';
import { breadcrumbJsonLd, itemListJsonLd } from '../lib/seo';
import { absoluteUrl } from '../lib/bible/urls';
import { hubFigures } from '../lib/images/hubs';
import { shareCardFromFigure } from '../lib/images/og';

setCacheControl(Astro.response, READER_CACHE_CONTROL);

const briefs = await listChapterBriefs();

/**
 * What this hub can honestly claim, which is two different numbers.
 *
 * The description used to read "Browse all 1,189 chapters of the Bible, with
 * clear chapter studies and notes from three free commentaries" — which a
 * reader and a snippet both take as 1,189 chapter studies. There are far fewer.
 * 1,189 is how many chapters you can *reach* from here; `briefs.length` is how
 * many have writing of our own on them, and the rest are `noindex` pages of
 * republished commentary that four larger sites already mirror.
 *
 * Both numbers stated, neither standing in for the other. The written count is
 * read from the same `listChapterBriefs()` the sitemap uses, so it cannot drift
 * from what the page below actually lists — which is the other half of the
 * problem with a hardcoded claim: it would have been wrong again the next time
 * somebody shipped a brief.
 */
const written = briefs.length;
const allChapters = TOTAL_CHAPTERS.toLocaleString('en-US');
const title = 'Bible Commentary and Chapter Studies | BibleHearth';
const description = written
	? `All ${allChapters} chapters of the Bible, browsable by book. ${written} ${written === 1 ? 'has' : 'have'} a study written in plain English; every chapter page carries notes from three free commentaries.`
	: `All ${allChapters} chapters of the Bible, browsable by book, each with notes from three free commentaries.`;

/** The same two numbers in the lede's own voice. Empty while nothing is written. */
const writtenSentence = written
	? `${written} ${written === 1 ? 'chapter has' : 'chapters have'} a study written by us as well: a walk through the chapter in order, in plain English, with the unfamiliar words explained. Those are listed first below.`
	: '';

const books = [
	{ heading: 'Old Testament', ids: OLD_TESTAMENT_BOOKS },
	{ heading: 'New Testament', ids: NEW_TESTAMENT_BOOKS },
];

const figure = hubFigures.study;
const share = figure ? await shareCardFromFigure(figure) : undefined;
---

<BaseLayout
	title={title}
	description={description}
	canonicalPath={STUDY_HUB_PATH}
	image={share?.image}
	imageAlt={share?.imageAlt}
	jsonLd={[
		breadcrumbJsonLd(Astro.site, [
			{ name: 'BibleHearth', path: '/' },
			{ name: 'Bible study', path: STUDY_HUB_PATH },
		]),
		itemListJsonLd({
			name: 'Bible commentary by book',
			items: [...OLD_TESTAMENT_BOOKS, ...NEW_TESTAMENT_BOOKS].map((id) => ({
				name: bookNameFromUsfm(id),
				url: absoluteUrl(Astro.site, bookStudyPath(id)),
			})),
		}),
	]}
>
	<nav class="crumbs" aria-label="Breadcrumb">
		<a href="/">Home</a>
		<span>/</span>
		<span>Bible study</span>
	</nav>

	<h1>Bible Commentary and Chapter Studies</h1>

	{/*
		The lede says which chapters have a study and which do not, because the
		page below is two things and a reader who does not know that will click a
		tile expecting the first and find the second. "Every chapter has a place
		here. Studies walk through the chapter in order" read as a promise of
		1,189 studies.
	*/}
	<p class="lede">
		Every chapter of the Bible is here, with notes from three free commentaries
		and no account or paywall. {writtenSentence} If you are new to the Bible,
		begin with the Tyndale notes; they use clear, modern English.
	</p>

	{figure ? <Figure figure={figure} /> : null}

	{
		briefs.length ? (
			<section>
				<h2>Chapters written up in full</h2>
				<p class="muted">
					These chapters include an original summary, an outline, a glossary, and
					answers to common questions.
				</p>
				<ul class="topic-links">
					{briefs.map((brief) => {
						const [book, chapter] = brief.data.usfm.split('.');
						return (
							<li>
								<a href={chapterStudyPath(book ?? '', chapter ?? '1')}>
									{brief.data.title}
								</a>
							</li>
						);
					})}
				</ul>
			</section>
		) : null
	}

	{
		books.map((group) => (
			<section>
				<h2>{group.heading}</h2>
				<div class="book-grid">
					{group.ids.map((id) => (
						<a class="tile" href={bookStudyPath(id)}>
							{bookNameFromUsfm(id)}
							<span class="tile-kicker">
								{chapterCount(id)} {chapterCount(id) === 1 ? 'chapter' : 'chapters'}
							</span>
						</a>
					))}
				</div>
			</section>
		))
	}

	<section>
		<h2>The commentaries on these pages</h2>
		<p class="muted">
			Listed in the order they appear on a chapter page, which is plainest first.
		</p>
		{
			COMMENTARY_SOURCES.map((source) => (
				<div class="theme-item">
					<h3>{source.name}</h3>
					<p class="source-byline">
						{source.byline} · {source.license.name}
					</p>
					<p>{source.about}</p>
					{source.readingNote ? <p class="muted">{source.readingNote}</p> : null}
				</div>
			))
		}
		<p class="muted">
			Full license and attribution details are on the{' '}
			<a href="/attributions">attributions page</a>.
		</p>
	</section>
</BaseLayout>
