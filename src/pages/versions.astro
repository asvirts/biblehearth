---
import type { BibleVersion } from '@youversion/platform-core';
import BaseLayout from '../layouts/BaseLayout.astro';
import StatusMessage from '../components/StatusMessage.astro';
import { editionForSlug, editionStyle } from '../lib/bible/editions';
import { absoluteUrl, versionPath } from '../lib/bible/urls';
import { READER_CACHE_CONTROL, setPageHeaders } from '../lib/http';
import { breadcrumbJsonLd, itemListJsonLd } from '../lib/seo';
import {
	displayAbbreviation,
	errorStatus,
	listVersions,
	versionSlug,
} from '../lib/youversion/api';

let versions: BibleVersion[] = [];
let status = 200;
let errorTitle = '';
let errorMessage = '';

try {
	versions = await listVersions();
} catch (error) {
	status = errorStatus(error);
	errorTitle = 'Versions are unavailable';
	errorMessage = 'The Bible catalog could not be loaded right now.';
}

Astro.response.status = status;
setPageHeaders(Astro.response, status, READER_CACHE_CONTROL);

/**
 * Each version paired with what we have written about it.
 *
 * The style label and the reading level are the two facts someone choosing a
 * translation is actually comparing, and both already exist in
 * lib/bible/editions.ts — the style derived from `approach` so the two can
 * never disagree. A version with no record still lists; it just lists without
 * them, which is the same fallback `/bible/<slug>` uses.
 */
const listed = versions.map((version) => {
	const slug = versionSlug(version, versions);
	const edition = editionForSlug(slug);
	return {
		slug,
		path: versionPath(slug),
		abbr: displayAbbreviation(version),
		name: edition?.name ?? version.localized_title ?? version.title,
		style: edition ? editionStyle(edition) : null,
		grade: edition?.readingGrade ?? null,
	};
});
---

<BaseLayout
	title="Bible Translations Compared — Which Should You Read?"
	description="Every English Bible translation on BibleHearth, compared: how literal each one is, how easy it is to read, and which to choose when you are starting out."
	canonicalPath="/versions"
	jsonLd={[
		breadcrumbJsonLd(Astro.site, [
			{ name: 'BibleHearth', path: '/' },
			{ name: 'Versions', path: '/versions' },
		]),
		itemListJsonLd({
			name: 'English Bible translations on BibleHearth',
			items: listed.map((item) => ({
				name: item.name,
				url: absoluteUrl(Astro.site, item.path),
			})),
		}),
	]}
>
	{
		status !== 200 ? (
			<StatusMessage title={errorTitle} message={errorMessage} />
		) : (
			<div class="stack">
				<section>
					<nav class="crumbs" aria-label="Breadcrumb">
						<a href="/">Home</a>
						<span>/</span>
						<span>Versions</span>
					</nav>
					<h1>Which Bible translation should you read?</h1>
					<p class="lede">
						Every translation here is a real Bible, worked out from the Hebrew and
						Greek by scholars. The differences between them are smaller than the
						arguments about them suggest — but they are real, and one of them
						will suit you better than the others.
					</p>
				</section>

				<section>
					<h2>The one difference that actually matters</h2>
					<p>
						Translators face the same choice on every verse: follow the original
						wording, or say what the sentence means in natural English. Follow
						the wording and you can see how the original was built, but the
						English comes out stiff — Paul argues in long Greek sentences, and
						they arrive as long English ones. Say what it means and it reads
						easily, but the decision the translator made is invisible to you.
					</p>
					<p>
						No translation does only one of these. Each one sits at a different
						point between them, and that is what the labels below are
						describing. “Formal” means it stays close to the wording.
						“Balanced” means it moves between the two. “Simplified” means it
						has been restated in the shortest sentences that will carry the
						meaning.
					</p>
				</section>

				<section>
					<h2>Two things that matter less than people think</h2>
					<p>
						The first is which one is <em>most accurate</em>. Every translation
						on this page is accurate. What they disagree about is what to do
						when accuracy and clarity pull in opposite directions, and that is a
						judgement, not an error.
					</p>
					<p>
						The second is reading level. A third-grade reading level does not
						mean a children’s Bible or a lesser one — it is the same book in
						shorter sentences. Adults who stall a few chapters into every other
						translation often read whole books in that one, and there is nothing
						odd about starting there.
					</p>
				</section>

				<section>
					<h2>How to choose</h2>
					<p>
						If you have not read much of the Bible before, start with the one
						that will not stop you: the NIV, or the NIrV if you want it plainer
						still. If you want to see how a sentence is built, read a formal
						translation alongside it. If you are stuck on a single verse rather
						than working through a book, the Amplified is built for exactly
						that.
					</p>
					<p>
						And read more than one. The cheapest way to find out whether a verse
						means what you think it means is to read it in a translation that
						words it differently.
					</p>
				</section>

				<section>
					<h2>The translations</h2>
					<div class="version-grid">
						{
							listed.map((item) => (
								<a class="tile" href={item.path}>
									<span class="tile-kicker">{item.abbr}</span>
									{item.name}
									{item.style || item.grade ? (
										<span class="muted">
											{' '}
											·{' '}
											{[item.style, item.grade].filter(Boolean).join(' · ')}
										</span>
									) : null}
								</a>
							))
						}
					</div>
					<p>
						Each one has a page of its own with where it came from, who made it,
						and the honest limitation of reading it.
					</p>
				</section>
			</div>
		)
	}
</BaseLayout>
