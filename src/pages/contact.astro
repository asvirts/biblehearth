---
import BaseLayout from '../layouts/BaseLayout.astro';
import { READER_CACHE_CONTROL, setCacheControl } from '../lib/http';
import { breadcrumbJsonLd, sitePageJsonLd } from '../lib/seo';
import {
	ABOUT_PATH,
	CONTACT_PATH,
	CORRECTIONS_ANCHOR,
	EDITORIAL_EMAIL,
	PRIVACY_PATH,
} from '../lib/site';

setCacheControl(Astro.response, READER_CACHE_CONTROL);

const title = 'Contact BibleHearth · Corrections and Permissions';
const description =
	'One address, read by a person: what to write to BibleHearth about, what happens to a correction, and the questions this address cannot answer.';

const mailto = `mailto:${EDITORIAL_EMAIL}`;

/*
 * What the address is for, in the order a message is likely to be about.
 *
 * Routing stated on the page rather than split across several addresses: one
 * inbox that is read beats four that look organised, and a contact page whose
 * addresses go nowhere is the failure this page exists to avoid.
 */
const reasons = [
	{
		heading: 'A correction',
		body: 'A passage we have misread, a definition that is off, a claim that needs a source, or an attribution crediting the wrong person. The most useful message names the page and quotes the sentence.',
	},
	{
		heading: 'Something broken',
		body: 'A page that will not load, a link that has rotted, a chapter that renders wrong, or text that has gone missing. Send the address of the page and what you were doing when it happened.',
	},
	{
		heading: 'Licensing and permissions',
		body: 'If you publish a translation or a commentary that appears here and want it handled differently, this is the right address, and it is read as a priority. It is also where to ask about reusing our own writing.',
	},
	{
		heading: 'A question about the writing',
		body: 'Why a page says what it says, what it leaves out, or which sources sit behind it. If the answer changes the page, the page changes.',
	},
] as const;
---

<BaseLayout
	title={title}
	description={description}
	canonicalPath={CONTACT_PATH}
	jsonLd={[
		breadcrumbJsonLd(Astro.site, [
			{ name: 'BibleHearth', path: '/' },
			{ name: 'Contact', path: CONTACT_PATH },
		]),
		sitePageJsonLd({
			site: Astro.site,
			path: CONTACT_PATH,
			type: 'ContactPage',
			name: 'Contact BibleHearth',
			description,
		}),
	]}
>
	<nav class="crumbs" aria-label="Breadcrumb">
		<a href="/">Home</a>
		<span>/</span>
		<span>Contact</span>
	</nav>

	<h1>Contact BibleHearth</h1>

	<p class="lede">
		One address, read by the person responsible for these pages:
		{' '}<a href={mailto}>{EDITORIAL_EMAIL}</a>. There is no form to fill in and
		no ticket number. This page says what it is good for, and what it is not.
	</p>

	<section>
		<h2>What to write about</h2>
		<dl class="glossary-list">
			{
				reasons.map((reason) => (
					<div class="glossary-item">
						<dt>{reason.heading}</dt>
						<dd>{reason.body}</dd>
					</div>
				))
			}
		</dl>
		<p class="muted">
			What happens to a correction is set out on the
			{' '}<a href={`${ABOUT_PATH}#${CORRECTIONS_ANCHOR}`}>about page</a>: it is
			made on the page itself, the review date moves with it, and a page that
			was wrong in a way that changed its meaning says so.
		</p>
	</section>

	<section>
		<h2>What this address cannot do</h2>
		<p>
			It is not pastoral care, and nobody here is your pastor. These pages
			explain what a passage says and how it has been read; they cannot tell you
			what to do about your marriage, your diagnosis or your grief, and an
			answer that tried to would be worth less than the one a person who knows
			you can give.
		</p>
		<p>
			If you are in crisis, please contact a doctor or a crisis line rather than
			this inbox. That is not a brush-off and it is not a failure of faith — it
			is the answer that helps, and email is far too slow for it.
		</p>
		<p>
			If your question is about the Bible App, we cannot help: this site is not
			YouVersion, and messages about accounts, plans, streaks or the app itself
			never reach them. Their own support is at
			{' '}<a
				href="https://help.youversion.com"
				rel="nofollow noopener"
				target="_blank">help.youversion.com</a
			>.
		</p>
	</section>

	<section>
		<h2>What to expect</h2>
		<p>
			A person reads everything that arrives, usually replying within a few
			days. A correction gets acted on whether or not it gets a reply, because
			fixing the page matters more than answering the message — though we try to
			do both.
		</p>
		<p>
			There is no telephone number and no postal address. This is a small site,
			email is the only channel anyone here watches, and publishing a number
			nobody answers would be worse than saying so plainly.
		</p>
		<p class="muted">
			See also: <a href={ABOUT_PATH}>about this site</a> for who publishes it and
			how the writing is made, <a href="/attributions">attributions</a> for every
			source and licence, and <a href={PRIVACY_PATH}>privacy</a> for what happens
			to an email you send and what the site measures.
		</p>
	</section>
</BaseLayout>
