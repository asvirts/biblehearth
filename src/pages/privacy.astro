---
import BaseLayout from '../layouts/BaseLayout.astro';
import { READER_CACHE_CONTROL, setCacheControl } from '../lib/http';
import { breadcrumbJsonLd, sitePageJsonLd } from '../lib/seo';
import {
	ABOUT_PATH,
	CONTACT_PATH,
	EDITORIAL_EMAIL,
	PRIVACY_PATH,
} from '../lib/site';

setCacheControl(Astro.response, READER_CACHE_CONTROL);

/*
 * The date this policy last changed, kept by hand.
 *
 * A privacy policy is the one page on this site where a date is load-bearing:
 * it is how a reader tells whether what they are reading still describes the
 * site. It is not generated from the build, because a build date would move
 * every deploy and quietly claim a review that never happened.
 *
 * Change it when the list of processors below changes — not otherwise.
 */
const UPDATED = new Date('2026-08-20T00:00:00Z');
const updatedLabel = UPDATED.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	timeZone: 'UTC',
});

const title = 'Privacy Policy · What BibleHearth Measures';
const description =
	'No accounts, no advertising, and nothing sold. The four analytics tools this site runs, named one by one, the cookies they set, and how to stop them.';

/*
 * Every third party that receives anything about a visit, with what it does
 * and whether it sets a cookie.
 *
 * Written out one by one rather than summarised as "we use analytics
 * providers", which is the phrasing that lets a policy stay true while telling
 * a reader nothing. If a script is added to BaseLayout and not added here,
 * this page has become false — that is the point of the list.
 */
const processors = [
	{
		name: 'Vercel',
		role: 'Hosting, and Web Analytics',
		collects:
			'Every request to this site passes through Vercel, which serves the pages and keeps ordinary server logs. Its Web Analytics records the page, the referrer, approximate location from the request, and the browser, operating system and device type.',
		cookies:
			'None. Vercel identifies a visit by a hash of the incoming request rather than a cookie, and discards it after 24 hours.',
		policy: 'https://vercel.com/legal/privacy-notice',
		policyLabel: 'vercel.com/legal/privacy-notice',
	},
	{
		name: 'Google Analytics 4',
		role: 'Traffic measurement',
		collects:
			'Page views, referrers, approximate location, and browser and device information, used to see which pages are read and how people arrive.',
		cookies:
			'Sets first-party cookies named _ga and _ga_ followed by a property identifier, which last up to two years by default — the longest-lived thing this site puts in your browser.',
		policy: 'https://policies.google.com/privacy',
		policyLabel: 'policies.google.com/privacy',
	},
	{
		name: 'Microsoft Clarity',
		role: 'Session replay and heatmaps',
		collects:
			'Records how a page was used — pointer movement, clicks, scrolling, and where a reader stopped. It is what tells us whether people reach the end of a chapter study or leave halfway down.',
		cookies:
			'Sets cookies named _clck and _clsk. Clarity applies its own consent mode by default to visitors in the European Economic Area, the United Kingdom and Switzerland, so it sets no cookie for those readers unless a consent signal is passed to it — and this site passes none.',
		policy: 'https://www.microsoft.com/en-us/privacy/privacystatement',
		policyLabel: 'Microsoft Privacy Statement',
	},
	{
		name: 'Ahrefs Web Analytics',
		role: 'Traffic measurement',
		collects:
			'Page views and referrers, used alongside the search data the same account reports on.',
		cookies: 'None, according to Ahrefs, which describes the script as cookie-free.',
		policy: 'https://ahrefs.com/legal/privacy-policy',
		policyLabel: 'ahrefs.com/legal/privacy-policy',
	},
] as const;
---

<BaseLayout
	title={title}
	description={description}
	canonicalPath={PRIVACY_PATH}
	jsonLd={[
		breadcrumbJsonLd(Astro.site, [
			{ name: 'BibleHearth', path: '/' },
			{ name: 'Privacy', path: PRIVACY_PATH },
		]),
		sitePageJsonLd({
			site: Astro.site,
			path: PRIVACY_PATH,
			type: 'WebPage',
			name: 'Privacy Policy',
			description,
			dateModified: UPDATED,
		}),
	]}
>
	<nav class="crumbs" aria-label="Breadcrumb">
		<a href="/">Home</a>
		<span>/</span>
		<span>Privacy</span>
	</nav>

	<h1>Privacy Policy</h1>

	<p class="lede">
		There is no account to make here, nothing that asks for your name, and no
		advertising. What is left is four measurement tools and the logs of the
		server that sends you the pages, and this policy names each of them and says
		what it does.
	</p>

	<p class="muted">Last updated {updatedLabel}.</p>

	<section>
		<h2>The short version</h2>
		<p>
			We do not know who you are and have no way to find out. Nothing on this
			site asks you for anything, nothing is sold or shared for money, no
			profile is built about you, and no advertising network is given anything.
			The measurement that does happen is aggregate — which pages get read, and
			roughly from where.
		</p>
		<p>
			The one thing worth reading past this section for is what the pages
			themselves reveal, which on a Bible site is not nothing. That is further
			down.
		</p>
	</section>

	<section>
		<h2>What this site does not do</h2>
		<ul class="outline-list">
			<li><p>There is no account, no login and no sign-up.</p></li>
			<li><p>There is no newsletter and no email is ever collected.</p></li>
			<li>
				<p>
					There is no advertising, no ad network, and no tracking pixel from a
					social platform or an advertiser.
				</p>
			</li>
			<li>
				<p>
					Nothing about a visit is sold, rented, or shared for money, and
					nothing is used to target advertising anywhere else.
				</p>
			</li>
			<li>
				<p>
					This site sets no cookies of its own. It keeps no session, so it has
					nothing to keep one in.
				</p>
			</li>
			<li>
				<p>
					No page here has a comment box, a form that asks about you, or a
					field you can type into. The only form on the site is three dropdowns
					that pick a translation, a book and a chapter — so the only thing you
					can submit to this site is which passage you want to read.
				</p>
			</li>
		</ul>
	</section>

	<section>
		<h2>Who receives what</h2>
		<p>
			Four third parties see something about a visit. Each is named here with
			what it collects and what it stores in your browser.
		</p>
		{
			processors.map((processor) => (
				<div class="theme-item">
					<h3>{processor.name}</h3>
					<p class="source-byline">{processor.role}</p>
					<dl class="glossary-list">
						<div class="glossary-item">
							<dt>What it collects</dt>
							<dd>{processor.collects}</dd>
						</div>
						<div class="glossary-item">
							<dt>Cookies</dt>
							<dd>{processor.cookies}</dd>
						</div>
						<div class="glossary-item">
							<dt>Their policy</dt>
							<dd>
								<a href={processor.policy} rel="nofollow noopener" target="_blank">
									{processor.policyLabel}
								</a>
							</dd>
						</div>
					</dl>
				</div>
			))
		}
		<p class="muted">
			That is the whole list. If a script is ever added to this site and not
			added here, this page has become wrong, and
			{' '}<a href={CONTACT_PATH}>telling us</a> is a correction like any other.
		</p>
	</section>

	<section>
		<h2>Session recording, plainly</h2>
		<p>
			Microsoft Clarity is the one on that list that surprises people, so it is
			worth saying in ordinary words: it can replay how a page was used, as a
			silent reconstruction of pointer movement, clicks and scrolling. It does
			not see your camera, your microphone, your other tabs, or anything outside
			this site.
		</p>
		<p>
			There is also nothing typed to record, because there is nowhere on this
			site to type. That is not a privacy feature we built so much as a
			consequence of the site having no accounts and no search box — but it does
			mean the usual worry about session recording, that it captures what you
			enter into a form, does not apply here.
		</p>
	</section>

	<section>
		<h2>What your reading reveals</h2>
		<p>
			This is the part specific to a Bible site, and it deserves saying
			straight. The passage you are reading is in the address of the page, so a
			page view records that someone read Psalm 23, or a topic page about grief,
			or a question about the unforgivable sin. In several countries what a
			person reads about their faith is treated as a special category of
			information, and rightly.
		</p>
		<p>
			None of it is tied to a name, an account or an email, because this site has
			none of those to tie it to, and we make no attempt to work backwards from
			a visit to a person. But it is measured, by the four tools above, and a
			page about a hard subject is measured exactly like any other.
		</p>
		<p>
			One thing does not happen. Scripture is fetched by our server, not by your
			browser, so reading a chapter here tells the translation's publisher
			nothing about you — no request from your device ever reaches them. The
			same is true of the commentaries: they are stored and served from here.
		</p>
	</section>

	<section>
		<h2>How to stop it</h2>
		<p>
			A content blocker will stop all four scripts, and nothing on this site
			breaks when it does. The pages are rendered on the server and ship almost
			no JavaScript, so with every script blocked you still get the whole site —
			the text, the commentary, the links. Nothing here detects a blocker, asks
			you to turn it off, or works less well because one is on.
		</p>
		<p>
			Private or incognito browsing discards the cookies at the end of the
			session, and clearing cookies for this site removes them. Google also
			publishes a
			{' '}<a
				href="https://tools.google.com/dlpage/gaoptout"
				rel="nofollow noopener"
				target="_blank">browser add-on that opts out of Google Analytics</a
			> across every site that uses it.
		</p>
		<p>
			Being straight about the limits: this site does not currently read Do Not
			Track or Global Privacy Control signals, so a blocker is the route that
			actually works rather than the one that ought to.
		</p>
	</section>

	<section>
		<h2>Email you send us</h2>
		<p>
			If you write to <a href={`mailto:${EDITORIAL_EMAIL}`}>{EDITORIAL_EMAIL}</a>,
			your message and address stay in that mailbox, and are used to answer you
			and to fix whatever you wrote about. They are not added to any list,
			because there is no list, and they are not passed to anyone else.
		</p>
	</section>

	<section>
		<h2>Children</h2>
		<p>
			This site is written for adults and older readers rather than for
			children, and it has no account, no profile and no way for anyone to
			submit information about themselves — so there is nothing here that
			knowingly collects a child's details. If you believe something has been
			collected about a child, write to us and we will remove what we can.
		</p>
	</section>

	<section>
		<h2>Your rights, and what we can honestly do</h2>
		<p>
			Depending on where you live, you may have the right to ask what is held
			about you, to have it corrected or deleted, or to object to it being
			processed at all. Write to
			{' '}<a href={`mailto:${EDITORIAL_EMAIL}`}>{EDITORIAL_EMAIL}</a> and we
			will do what we can.
		</p>
		<p>
			What we can honestly do is limited, and by design. Because nothing here is
			tied to an identity, we cannot look you up — there is no record with your
			name on it to send you, correct or delete. For the aggregate measurement
			that does exist, the effective remedy is the one above: block the scripts,
			and nothing about your visits is measured at all. For anything held by
			Google, Microsoft, Ahrefs or Vercel about you across their own services,
			their policies above are where those requests are handled.
		</p>
	</section>

	<section>
		<h2>Changes to this page</h2>
		<p>
			When the list of tools above changes, this page changes with it and the
			date at the top moves. There is no archive of previous versions; if you
			want to know what it said before, ask.
		</p>
		<p class="muted">
			See also: <a href={ABOUT_PATH}>about this site</a>, and
			{' '}<a href={CONTACT_PATH}>contact</a>.
		</p>
	</section>
</BaseLayout>
