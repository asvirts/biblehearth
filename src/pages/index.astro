---
import type { BiblePassage, BibleVersion, VOTD } from '@youversion/platform-core';
import BaseLayout from '../layouts/BaseLayout.astro';
import Figure from '../components/Figure.astro';
import Passage from '../components/Passage.astro';
import CopyrightNotice from '../components/CopyrightNotice.astro';
import StatusMessage from '../components/StatusMessage.astro';
import { answerPath, listAnswers } from '../lib/answers';
import { isNumericChapter, parsePassageId } from '../lib/bible/usfm';
import { chapterPath, versePath, versionPath } from '../lib/bible/urls';
import { HOME_CACHE_CONTROL, setPageHeaders } from '../lib/http';
import { websiteJsonLd } from '../lib/seo';
import { hubFigures } from '../lib/images/hubs';
import { shareCardFromFigure } from '../lib/images/og';
import {
	BibleUnavailableError,
	displayAbbreviation,
	errorStatus,
	getBibleIndex,
	getDefaultVersion,
	getPassageHtml,
	getVerseOfTheDay,
	listVersions,
	PlatformConfigError,
	versionSlug,
} from '../lib/youversion/api';

let status = 200;
let errorTitle = '';
let errorMessage = '';
let defaultVersion: BibleVersion | null = null;
let catalog: BibleVersion[] = [];
let votd: VOTD | null = null;
let votdPassage: BiblePassage | null = null;
let startHref = '/versions';

try {
	[defaultVersion, catalog] = await Promise.all([
		getDefaultVersion(),
		listVersions(),
	]);

	if (defaultVersion) {
		const slug = versionSlug(
			defaultVersion,
			catalog.length ? catalog : [defaultVersion],
		);
		const index = await getBibleIndex(defaultVersion.id);
		const firstBook = index.books[0];
		const firstChapter = firstBook?.chapters.find((chapter) =>
			isNumericChapter(chapter.id),
		);
		startHref =
			firstBook && firstChapter
				? chapterPath(slug, firstBook.id, firstChapter.id)
				: versionPath(slug);
		votd = await getVerseOfTheDay();
		if (votd) {
			votdPassage = await getPassageHtml(defaultVersion.id, votd.passage_id, {
				headings: false,
				notes: false,
			});
		}
	}
} catch (error) {
	status = errorStatus(error);
	errorTitle =
		error instanceof PlatformConfigError
			? 'Bible text is not configured'
			: 'Bible text is temporarily unavailable';
	errorMessage =
		error instanceof PlatformConfigError
			? 'Add YVP_APP_KEY to your local environment, then restart the dev server.'
			: error instanceof BibleUnavailableError
				? error.message
				: 'Please try again in a moment.';
}

Astro.response.status = status;
setPageHeaders(Astro.response, status, HOME_CACHE_CONTROL);

const versionLabel = defaultVersion ? displayAbbreviation(defaultVersion) : '';
const parsedVotd = votd ? parsePassageId(votd.passage_id) : null;
const votdHref =
	defaultVersion && parsedVotd?.chapter
		? parsedVotd.verse
			? versePath(
					versionSlug(defaultVersion, catalog.length ? catalog : [defaultVersion]),
					parsedVotd.book,
					parsedVotd.chapter,
					parsedVotd.verse,
				)
			: chapterPath(
					versionSlug(defaultVersion, catalog.length ? catalog : [defaultVersion]),
					parsedVotd.book,
					parsedVotd.chapter,
				)
		: startHref;

// The home page is the strongest internal-link donor on the site, so the
// editorial pages get a slot here rather than relying on the footer alone.
const answers = await listAnswers();
const featured = catalog.slice(0, 8);

/**
 * Static, and that is the fix.
 *
 * The title and description here used to be the Verse of the Day: the
 * description was the psalm's own text, truncated. A description that changes
 * every midnight cannot rank for anything, because it never describes the same
 * page twice — and what it described was a passage rather than the site, on the
 * one URL that will accrue more links than any other. The verse is still the
 * first thing on the page; it is just no longer what the page claims to be.
 *
 * The title spends its 56 characters on the differentiator rather than on
 * "Read the Bible", which is the query this site cannot win and four platforms
 * own outright. What is ours is the plain-English writing, so that is what the
 * title says.
 */
const description =
	'Read the Bible free online, with plain-English studies of the chapters ' +
	'people ask about most: what the chapter says, what it means, and what it ' +
	'does not.';

const figure = hubFigures.home;
const share = await shareCardFromFigure(figure);
---

<BaseLayout
	title="BibleHearth — Read the Bible, Explained in Plain English"
	description={description}
	canonicalPath="/"
	image={share.image}
	imageAlt={share.imageAlt}
	jsonLd={websiteJsonLd({ site: Astro.site, description })}
>
	{
		status !== 200 ? (
			<StatusMessage title={errorTitle} message={errorMessage} />
		) : (
			<div class="stack">
				<section>
					<p class="muted">A quiet place to read Scripture</p>
					<h1>Read the Bible, and understand what you read</h1>
					<p class="lede">
						Every chapter and verse in several English translations, plus
						plain-English studies of the passages people ask about most —
						written for anyone new to the Bible.
					</p>
					<Figure figure={figure} />
					<p>
						<a class="cta" href={startHref}>
							Start reading{versionLabel ? ` in ${versionLabel}` : ''}
						</a>
					</p>
				</section>

				{
					votdPassage ? (
						<section class="panel">
							<p class="tile-kicker">
								<a href="/verse-of-the-day">Verse of the day</a>
							</p>
							<h2>{votdPassage.reference}</h2>
							<Passage html={votdPassage.content} />
							<p>
								<a href={votdHref}>Read this passage</a>
								{' · '}
								<a href="/verse-of-the-day">Today's verse in context</a>
							</p>
							{defaultVersion ? <CopyrightNotice version={defaultVersion} /> : null}
						</section>
					) : null
				}

				{
					answers.length > 0 ? (
						<section>
							<h2>Questions people ask</h2>
							<div class="version-grid">
								{answers.map((answer) => (
									<a class="tile" href={answerPath(answer.id)}>
										<span class="tile-kicker">Answer</span>
										{answer.data.question}
									</a>
								))}
							</div>
							<p>
								<a href="/answers">All questions</a>
								{' · '}
								<a href="/topics">Bible verses by topic</a>
							</p>
						</section>
					) : null
				}

				{
					featured.length > 0 ? (
						<section>
							<h2>English versions</h2>
							<div class="version-grid">
								{featured.map((version) => {
									const slug = versionSlug(version, catalog);
									return (
										<a class="tile" href={versionPath(slug)}>
											<span class="tile-kicker">{displayAbbreviation(version)}</span>
											{version.localized_title || version.title}
										</a>
									);
								})}
							</div>
							<p>
								<a href="/versions">Browse all versions</a>
							</p>
						</section>
					) : null
				}
			</div>
		)
	}
</BaseLayout>
