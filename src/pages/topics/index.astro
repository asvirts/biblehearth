---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Figure from '../../components/Figure.astro';
import { HOME_CACHE_CONTROL, setCacheControl } from '../../lib/http';
import { breadcrumbJsonLd, itemListJsonLd } from '../../lib/seo';
import { absoluteUrl } from '../../lib/bible/urls';
import { listTopics, topicPath, topicVerseCount } from '../../lib/topics';
import { hubFigures } from '../../lib/images/hubs';
import { shareCardFromFigure } from '../../lib/images/og';

setCacheControl(Astro.response, HOME_CACHE_CONTROL);

const topics = await listTopics();
const names = topics
	.slice(0, 3)
	.map((topic) => topic.data.title)
	.join(', ');

const figure = hubFigures.topics;
const share = figure ? await shareCardFromFigure(figure) : undefined;
---

<BaseLayout
	title={`Bible Topics | Verses About ${names} and More`}
	description={`Find Bible verses by topic, grouped by theme and explained in context. Browse ${topics.length} topics, including ${names.toLowerCase()}.`}
	canonicalPath="/topics"
	image={share?.image}
	imageAlt={share?.imageAlt}
	jsonLd={[
		breadcrumbJsonLd(Astro.site, [
			{ name: 'BibleHearth', path: '/' },
			{ name: 'Topics', path: '/topics' },
		]),
		itemListJsonLd({
			name: 'Bible topics',
			items: topics.map((topic) => ({
				name: `Bible verses about ${topic.data.title.toLowerCase()}`,
				url: absoluteUrl(Astro.site, topicPath(topic.id)),
			})),
		}),
	]}
>
	<nav class="crumbs" aria-label="Breadcrumb">
		<a href="/">Home</a>
		<span>/</span>
		<span>Topics</span>
	</nav>

	<h1>Bible Verses by Topic</h1>
	<p class="lede">
		Each topic brings related passages together by theme. A short note explains
		who is speaking, what is happening, and why the verse belongs in the list.
		Where a passage is often misused, the page explains the problem directly.
	</p>

	{figure ? <Figure figure={figure} /> : null}

	<div class="stack">
		{
			topics.map((topic) => (
				<article class="panel">
					<h2>
						<a href={topicPath(topic.id)}>
							Bible Verses About {topic.data.title}
						</a>
					</h2>
					{/* A one-line definition makes this hub itself answerable. */}
					<p>{topic.data.shortAnswer}</p>
					<p class="muted">
						{topicVerseCount(topic)} verses in {topic.data.groups.length} groups
						{topic.data.aliases.length
							? ` · also: ${topic.data.aliases.slice(0, 3).join(', ')}`
							: ''}
					</p>
				</article>
			))
		}
	</div>
</BaseLayout>
