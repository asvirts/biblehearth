---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
	NEW_TESTAMENT_BOOKS,
	OLD_TESTAMENT_BOOKS,
	TOTAL_CHAPTERS,
	chapterCount,
} from '../../lib/bible/chapters';
import { bookNameFromUsfm } from '../../lib/bible/usfm';
import {
	COMMENTARY_SOURCES,
	commentaryBookPath,
	commentaryPath,
	listChapterBriefs,
} from '../../lib/commentary';
import { READER_CACHE_CONTROL, setCacheControl } from '../../lib/http';
import { breadcrumbJsonLd, itemListJsonLd } from '../../lib/seo';
import { absoluteUrl } from '../../lib/bible/urls';

setCacheControl(Astro.response, READER_CACHE_CONTROL);

const briefs = await listChapterBriefs();

const title = 'Bible Commentary — Free Chapter-by-Chapter Study Notes';
const description = `Free commentary on every chapter of the Bible: what each chapter says, what it means, and notes from three commentaries. ${TOTAL_CHAPTERS} chapters, written to be understood by someone reading the Bible for the first time.`;

const books = [
	{ heading: 'Old Testament', ids: OLD_TESTAMENT_BOOKS },
	{ heading: 'New Testament', ids: NEW_TESTAMENT_BOOKS },
];
---

<BaseLayout
	title={title}
	description={description}
	canonicalPath="/commentary"
	jsonLd={[
		breadcrumbJsonLd(Astro.site, [
			{ name: 'BibleHearth', path: '/' },
			{ name: 'Commentary', path: '/commentary' },
		]),
		itemListJsonLd({
			name: 'Bible commentary by book',
			items: [...OLD_TESTAMENT_BOOKS, ...NEW_TESTAMENT_BOOKS].map((id) => ({
				name: bookNameFromUsfm(id),
				url: absoluteUrl(Astro.site, commentaryBookPath(id)),
			})),
		}),
	]}
>
	<nav class="crumbs" aria-label="Breadcrumb">
		<a href="/">Home</a>
		<span>/</span>
		<span>Commentary</span>
	</nav>

	<h1>Bible Commentary</h1>

	<p class="lede">
		A study page for every chapter of the Bible. Each one lays the chapter out in
		order, explains the words that need explaining, and then gives you what three
		commentaries wrote about it — in full, free, with no account and no paywall.
		If you are new to reading the Bible, start with the Tyndale notes on any
		page: they are written in plain modern English.
	</p>

	{
		briefs.length ? (
			<section>
				<h2>Chapters written up in full</h2>
				<p class="muted">
					These chapters have a summary, an outline, a plain-English glossary and
					answers to the questions people actually ask about them.
				</p>
				<ul class="topic-links">
					{briefs.map((brief) => {
						const [book, chapter] = brief.data.usfm.split('.');
						return (
							<li>
								<a href={commentaryPath(book ?? '', chapter ?? '1')}>
									{brief.data.title}
								</a>
							</li>
						);
					})}
				</ul>
			</section>
		) : null
	}

	{
		books.map((group) => (
			<section>
				<h2>{group.heading}</h2>
				<div class="book-grid">
					{group.ids.map((id) => (
						<a class="tile" href={commentaryBookPath(id)}>
							{bookNameFromUsfm(id)}
							<span class="tile-kicker">
								{chapterCount(id)} {chapterCount(id) === 1 ? 'chapter' : 'chapters'}
							</span>
						</a>
					))}
				</div>
			</section>
		))
	}

	<section>
		<h2>The commentaries on these pages</h2>
		<p class="muted">
			Listed in the order they appear on a chapter page, which is plainest first.
		</p>
		{
			COMMENTARY_SOURCES.map((source) => (
				<div class="theme-item">
					<h3>{source.name}</h3>
					<p class="source-byline">
						{source.byline} · {source.license.name}
					</p>
					<p>{source.about}</p>
					{source.readingNote ? <p class="muted">{source.readingNote}</p> : null}
				</div>
			))
		}
		<p class="muted">
			Full licence and attribution details are on the{' '}
			<a href="/attributions">attributions page</a>.
		</p>
	</section>
</BaseLayout>
