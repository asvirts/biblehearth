# YouVersion Platform App Key from https://platform.youversion.com/
# Never commit a real value. Store it locally in .env.local and as a Vercel env var.
YVP_APP_KEY=

# Default Bible version ID. 111 is the New International Version (NIV).
DEFAULT_BIBLE_ID=111

# Bing Webmaster Tools ownership token — the `content` value of the
# msvalidate.01 meta tag it offers under Add site → HTML Meta Tag.
# Optional: without it the tag is omitted and the site still builds.
BING_SITE_VERIFICATION=

# Google Search Console ownership token — the `content` value of the
# google-site-verification meta tag. Optional: without it the tag is omitted.
GOOGLE_SITE_VERIFICATION=
